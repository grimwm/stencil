#!/usr/bin/env bash
# Adapted from the file pre-commit generates: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03
#
# Maintained by hand, because `pre-commit install` refuses to write hooks while
# core.hooksPath points at .beads/hooks -- the same arrangement pre-push uses.

# start templated
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

# pre-commit bakes an absolute INSTALL_PYTHON into the file it generates, which
# names whichever interpreter that one contributor installed it with. Tracked in
# git, it cannot be right for two people at once; this one arrived as a macOS
# path in a repo cloned to /home, where it fell through to whatever `pre-commit`
# happened to be on PATH. Resolve the repo's own venv from the hook's location
# instead. PRE_COMMIT_PYTHON overrides it for an interpreter kept elsewhere.
REPO="$(cd "$HERE/../.." && pwd)"
INSTALL_PYTHON="${PRE_COMMIT_PYTHON:-$REPO/.venv/bin/python3}"

# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---

# --- Export the tracker into the checkout being committed (stn-nkvl) ---
#
# bd anchors `.beads/` where the Dolt database lives, and that is the main
# checkout: a `bd` write from a worktree rewrites the MAIN checkout's
# .beads/issues.jsonl and never the worktree's (measured -- the worktree file's
# mtime did not move; the main checkout's did). AGENTS.md asks for worktrees and
# keeps main pull-request-only, so every worktree commit carried a stale export
# while the main checkout sat permanently dirty with one nothing could commit
# there. Export here instead, into the tree this commit is taken from, and stage
# it: every commit then carries the tracker as of that commit, and the pre-push
# drift guard has nothing left to catch on a new commit. `export.auto` is off in
# .beads/config.yaml for the same reason -- the export is written by this hook
# or by a pull, never by a `bd` write.
#
# `$0` is the main checkout's hook file whichever worktree is committing, so the
# committing tree is asked of git rather than derived from HERE.
if command -v bd >/dev/null 2>&1; then
  _tree="$(git rev-parse --show-toplevel)"
  _main="$(cd "$_tree" && cd "$(git rev-parse --git-common-dir)/.." && pwd)"
  if git -C "$_tree" ls-files --error-unmatch .beads/issues.jsonl >/dev/null 2>&1; then
    if _export_err="$(bd export -o "$_tree/.beads/issues.jsonl" 2>&1 >/dev/null)"; then
      git -C "$_tree" add .beads/issues.jsonl
    elif grep -qi 'no beads database found' <<<"$_export_err"; then
      # A clone with bd installed and no database (a sandbox, usually). The
      # same case the BEADS block above skips on exit 3, so nothing to hold the
      # export against; AGENTS.md asks the pull request to say so.
      echo >&2 "beads: no database on this machine -- committing .beads/issues.jsonl as it is"
    else
      # bd is here and the database will not export. Committing now would look
      # exactly like a fresh export, which is what the pre-push guard exists to
      # refuse; refuse it here, where the cause is still on screen.
      echo >&2 "beads: bd export failed; refusing to commit a stale .beads/issues.jsonl:"
      echo >&2 "$_export_err"
      exit 1
    fi
  fi
  # interactions.jsonl is append-only, and bd appends it in the main checkout
  # too. Union the main checkout's lines into this tree's copy -- order kept,
  # exact duplicates dropped -- so a worktree commit carries what bd wrote since
  # the branch was cut without losing lines the branch already has.
  if git -C "$_tree" ls-files --error-unmatch .beads/interactions.jsonl >/dev/null 2>&1; then
    if [ "$_main" != "$_tree" ] && [ -f "$_main/.beads/interactions.jsonl" ]; then
      awk '!seen[$0]++' "$_tree/.beads/interactions.jsonl" "$_main/.beads/interactions.jsonl" \
        > "$_tree/.beads/interactions.jsonl.tmp" \
        && mv -f "$_tree/.beads/interactions.jsonl.tmp" "$_tree/.beads/interactions.jsonl"
    fi
    git -C "$_tree" add .beads/interactions.jsonl
  fi
fi

if [ -x "$INSTALL_PYTHON" ]; then
    exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"
elif command -v pre-commit > /dev/null; then
    exec pre-commit "${ARGS[@]}"
else
    echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
    exit 1
fi
