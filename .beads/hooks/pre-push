#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-push' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-push "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-push' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-push'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---

# Chain the pre-commit framework, which runs the export drift check declared in
# .pre-commit-config.yaml. `pre-commit install` refuses to write hooks while
# core.hooksPath points here, so the call is wired in by hand -- the same
# arrangement .beads/hooks/pre-commit already uses for the commit-stage hooks.
#
# Kept in sh rather than copying that file's bash array and its venv lookup: a
# push runs rarely enough that resolving `pre-commit` from PATH is no loss.
_here="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$_here/../.." && pwd)"
INSTALL_PYTHON="${PRE_COMMIT_PYTHON:-$REPO/.venv/bin/python3}"
_remote="$1"
_url="$2"

# Git names every ref update on stdin, one line of
# `<local ref> <local sha> <remote ref> <remote sha>` per ref. `pre-commit
# hook-impl` consumes that stream and boils it down to a single from/to pair, so
# a push carrying several branches would leave all but one of them unchecked.
# The local shas are captured here and handed on out of band; stdin is then
# replayed verbatim so pre-commit still sees exactly what git sent.
#
# All-zero shas are ref deletions -- there is no revision to read an export out
# of -- and are dropped.
_bd_updates="$(cat)"

# git sends no lines at all when every ref is already up to date, and an empty
# `_bd_updates` must replay as zero bytes, not the one blank line `printf '%s\n'
# ""` would emit -- `pre-commit hook-impl` unpacks each replayed line into four
# fields and aborts on an empty one. One function feeds every replay site (this
# one, both branches below) so they cannot drift apart on that rule.
_bd_replay() {
  if [ -n "$_bd_updates" ]; then
    printf '%s\n' "$_bd_updates"
  fi
}

BD_PUSHED_REVISIONS="$(_bd_replay \
  | awk '$2 ~ /^[0-9a-fA-F]+$/ && $2 !~ /^0+$/ { print $2 }' \
  | sort -u | tr '\n' ' ')"
export BD_PUSHED_REVISIONS

# The repo's venv first, PATH second, and a hard failure last -- the same order
# .beads/hooks/pre-commit uses. Skipping silently when pre-commit is not on PATH
# is how this hook came to do nothing at all: the drift guard it exists to run
# was never reached on a machine that had not activated the virtualenv.
if [ -x "$INSTALL_PYTHON" ]; then
  _bd_replay | "$INSTALL_PYTHON" -mpre_commit hook-impl \
    --config=.pre-commit-config.yaml \
    --hook-type=pre-push \
    --hook-dir "$_here" -- "$_remote" "$_url"
elif command -v pre-commit >/dev/null 2>&1; then
  _bd_replay | pre-commit hook-impl \
    --config=.pre-commit-config.yaml \
    --hook-type=pre-push \
    --hook-dir "$_here" -- "$_remote" "$_url"
else
  echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
  exit 1
fi
exit $?
