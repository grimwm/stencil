{# Driver behind `make pdf`. Prints an already-generated HTML file to PDF
   through headless Chromium. Rendered into the package directory next to the
   Lua filters, so a project can override it from its own templates_dir. #}
"use strict";

// Chromium's own --print-to-pdf would be a smaller dependency, but it cannot
// answer the only two questions that matter here: has the page finished
// building itself, and did every asset it depends on actually arrive. It
// captures whatever is on screen at an arbitrary moment and exits 0 either
// way. Puppeteer can wait for the first and detect the second.
const puppeteer = require("puppeteer");
const fs = require("fs");
const {
  PDFDocument,
  PDFName,
  PDFDict,
  PDFArray,
  PDFHexString,
  PDFRawStream,
  decodePDFRawStream,
} = require("pdf-lib");

const [input, output] = process.argv.slice(2);

if (!input || !output) {
  console.error("usage: html-to-pdf.js <input.html> <output.pdf>");
  process.exit(2);
}

// Generated pages are self-contained: embed-images.lua inlines local images,
// and stencil gen inlines Bootstrap, highlight.js, Mermaid and the webfonts.
// A typical handout never makes a network request. The collector below still
// refuses to write when any request fails, so a page that has been edited to
// fetch something that is not there cannot ship a finished-looking PDF missing
// whatever that fetch was supposed to provide -- same spirit as the pandoc
// services running with --fail-if-warnings.
const failures = [];

// Long enough for a deck full of diagrams, short enough that a genuinely stuck
// page fails the build instead of hanging CI.
const TIMEOUT_MS = 120000;

function assertNoFailures() {
  if (failures.length > 0) {
    throw new Error("assets failed to load");
  }
}

// PDF/UA-1 needs two things from the file that Chromium does not write, and
// neither can be produced from the HTML side no matter how the page is marked
// up. Measured with veraPDF 1.30.2 --flavour ua1 on a real handout: 101 rules
// passed, 5 failed, and two of the five are these.
//
//   7.1 t5   "Non-standard structure type Strong is not mapped to a standard
//            type". Chromium tags <strong> as /Strong, which is not one of the
//            standard structure types in ISO 32000-1 14.8.4, and writes no
//            /RoleMap to say what it means. <b> tags identically, so there is
//            no HTML spelling that avoids it.
//
//   7.1 t8   The catalog has no /Metadata stream at all.
//
// The role map is BUILT FROM THE DOCUMENT rather than hardcoded to Strong and
// Em. Chromium's tag vocabulary is not a published contract and this image
// does not pin it, so a browser bump that starts emitting one more
// non-standard type would otherwise reintroduce exactly this failure with
// nothing to catch it until the next PDF/UA run.

// ISO 32000-1 14.8.4. Anything outside this set needs a role map entry.
const STANDARD_STRUCTURE_TYPES = new Set([
  "Document", "Part", "Art", "Sect", "Div", "BlockQuote", "Caption", "TOC",
  "TOCI", "Index", "NonStruct", "Private", "P", "H", "H1", "H2", "H3", "H4",
  "H5", "H6", "L", "LI", "Lbl", "LBody", "Table", "TR", "TH", "TD", "THead",
  "TBody", "TFoot", "Span", "Quote", "Note", "Reference", "BibEntry", "Code",
  "Link", "Annot", "Ruby", "RB", "RT", "RP", "Warichu", "WT", "WP", "Figure",
  "Formula", "Form",
]);

function collectStructureTypes(node, context, found, seen) {
  if (!node) return;
  const resolved = node instanceof PDFDict ? node : context.lookup(node);
  if (!resolved) return;

  if (resolved instanceof PDFArray) {
    for (let i = 0; i < resolved.size(); i += 1) {
      collectStructureTypes(resolved.get(i), context, found, seen);
    }
    return;
  }
  if (!(resolved instanceof PDFDict)) return;

  // The tree is a DAG in practice -- /K entries are shared -- so an unguarded
  // walk revisits nodes and, on a large deck, does not finish.
  const ref = resolved.dict ? null : resolved;
  if (ref && seen.has(ref)) return;
  if (ref) seen.add(ref);

  const type = resolved.get(PDFName.of("S"));
  if (type instanceof PDFName) {
    const name = type.asString().replace(/^\//, "");
    if (!STANDARD_STRUCTURE_TYPES.has(name)) found.add(name);
  }
  collectStructureTypes(resolved.get(PDFName.of("K")), context, found, seen);
}

// PDF/UA 7.2 t20: "LI element may contain only Lbl and LBody elements".
// Chromium tags a list item's content straight onto the /LI with no /LBody
// around it. Measured, this is not about tight versus loose markdown lists --
// <li>text</li> and <li><p>text</p></li> both fail, so there is no authoring
// spelling that avoids it.
//
// The repair is structural and says nothing new about the document: everything
// in a list item that is not its label IS the item's body, which is what
// /LBody means. So the children are moved into one, and the /P parent links
// are repointed at it so the tree stays walkable in both directions.
function wrapListBodies(structTreeRoot, context) {
  let wrapped = 0;
  const seen = new Set();

  const visit = (ref) => {
    const node = context.lookup(ref);
    if (!node) return;

    if (node instanceof PDFArray) {
      for (let i = 0; i < node.size(); i += 1) visit(node.get(i));
      return;
    }
    if (!(node instanceof PDFDict)) return;
    if (seen.has(node)) return;
    seen.add(node);

    const kids = node.get(PDFName.of("K"));
    const type = node.get(PDFName.of("S"));

    if (type instanceof PDFName && type.asString() === "/LI") {
      const children = [];
      const resolvedKids = context.lookup(kids);
      if (resolvedKids instanceof PDFArray) {
        for (let i = 0; i < resolvedKids.size(); i += 1) children.push(resolvedKids.get(i));
      } else if (kids) {
        children.push(kids);
      }

      // Anything already correct is left alone: a run that has nothing to fix
      // must not rewrite the tree, or every rebuild churns the file.
      const stray = children.filter((child) => {
        const c = context.lookup(child);
        if (!(c instanceof PDFDict)) return true;
        const s = c.get(PDFName.of("S"));
        const name = s instanceof PDFName ? s.asString() : "";
        return name !== "/Lbl" && name !== "/LBody";
      });
      if (stray.length) {
        const keep = children.filter((c) => !stray.includes(c));
        const body = context.obj({ Type: "StructElem", S: "LBody" });
        const bodyRef = context.register(body);
        body.set(PDFName.of("P"), ref);
        body.set(PDFName.of("K"), context.obj(stray));
        for (const child of stray) {
          const c = context.lookup(child);
          if (c instanceof PDFDict) c.set(PDFName.of("P"), bodyRef);
        }
        node.set(PDFName.of("K"), context.obj([...keep, bodyRef]));
        wrapped += 1;
      }
    }

    visit(node.get(PDFName.of("K")));
  };

  visit(structTreeRoot.get(PDFName.of("K")));
  return wrapped;
}

// PDF/UA-1 7.18.1 t2 and 7.18.5 t2: a link annotation needs an alternate
// description in its /Contents key. Chromium writes the /Annots array, the
// /Link annotation and its /A /URI action, and no /Contents -- and there is no
// HTML that makes it, because /Contents is a PDF-level description with no DOM
// equivalent, exactly as /Alt on a /Figure had none in 0.15.0.
//
// Measured with veraPDF 1.30.2 --flavour ua1 on the CS 425 corpus: three of the
// six handouts failed both rules and nothing else was wrong with them. They
// contain hyperlinks; tests/test_pdf_ua.py's fixture did not, which is why
// 0.21.0 reported full conformance.
//
// WHAT THE DESCRIPTION SAYS MATTERS MORE THAN THAT IT EXISTS. A /Contents
// reading "https://example.com/a/b/c.html" satisfies the checker and tells a
// reader nothing, and the whole lesson of role="none" in 0.15.0 is that
// clearing a rule is not the same as helping anyone. So the link TEXT is
// preferred and the URI is only the fallback.
//
// The text is read from the DOM before printing rather than out of the PDF.
// Recovering it from the content stream would mean decoding subset-font glyph
// codes back through each /ToUnicode CMap; the browser still has the words.

// Anchors, in document order, with the words a reader sees. Run under print
// emulation and filtered to anchors that actually lay out, so the list matches
// what Chromium is about to write annotations for rather than what the screen
// shows.
async function collectLinkText(page) {
  await page.emulateMediaType("print");
  return page.evaluate(() => {
    const norm = (value) => String(value || "").replace(/\s+/g, " ").trim();
    return Array.from(document.querySelectorAll("a[href]"))
      .filter((anchor) => anchor.getClientRects().length > 0)
      .map((anchor) => {
        // An image-only link -- a logo, a badge -- has no text of its own, and
        // its picture's accessible name is the description a reader wants.
        const labelled = anchor.querySelector("[aria-label], img[alt], [alt]");
        const fromLabelled = labelled
          ? norm(labelled.getAttribute("aria-label") || labelled.getAttribute("alt"))
          : "";
        const text =
          norm(anchor.getAttribute("aria-label")) ||
          norm(anchor.textContent) ||
          fromLabelled ||
          norm(anchor.getAttribute("title"));
        return { href: anchor.href, text: text };
      });
  });
}

// Every /Link structure element, in reading order, with the annotations each
// one owns. This is the join between the DOM and the file: Chromium emits one
// /Link element per anchor and hangs an /OBJR under it for every annotation
// that anchor produced -- two when the link wraps across a line, two again for
// an image link. Matching annotations to anchors positionally would get those
// cases wrong; the tree already knows the grouping.
function collectLinkStructElems(structTreeRoot, context) {
  const links = [];
  const seen = new Set();

  const visit = (ref, owner) => {
    const node = context.lookup(ref);
    if (!node) return;

    if (node instanceof PDFArray) {
      for (let i = 0; i < node.size(); i += 1) visit(node.get(i), owner);
      return;
    }
    if (!(node instanceof PDFDict)) return;

    const kind = node.get(PDFName.of("Type"));
    if (kind instanceof PDFName && kind.asString() === "/OBJR") {
      if (owner) owner.annots.push(node.get(PDFName.of("Obj")));
      return;
    }

    // Same guard as collectStructureTypes: /K entries are shared, so an
    // unguarded walk revisits nodes and does not finish on a large deck.
    if (seen.has(node)) return;
    seen.add(node);

    const structure = node.get(PDFName.of("S"));
    let current = owner;
    if (structure instanceof PDFName && structure.asString() === "/Link") {
      current = { annots: [] };
      links.push(current);
    }
    visit(node.get(PDFName.of("K")), current);
  };

  visit(structTreeRoot.get(PDFName.of("K")), null);
  return links;
}

function pdfStringText(value) {
  if (!value) return null;
  if (typeof value.decodeText === "function") {
    try {
      return value.decodeText();
    } catch (error) {
      // A malformed string is not worth failing the build over; the caller
      // falls back to a description it can still produce.
    }
  }
  if (typeof value.asString === "function") return value.asString();
  return null;
}

function linkUri(annot, context) {
  const action = context.lookup(annot.get(PDFName.of("A")));
  if (!(action instanceof PDFDict)) return null;
  return pdfStringText(context.lookup(action.get(PDFName.of("URI"))));
}

// An internal link carries a named destination instead of a URI. The name is
// the anchor it jumps to, which is a poor description but a true one, and it
// is only reached when the anchor had no text either.
function linkDestination(annot, context) {
  const dest = context.lookup(annot.get(PDFName.of("Dest")));
  if (dest instanceof PDFName) return dest.asString().replace(/^\//, "");
  return pdfStringText(dest);
}

function describeLinkAnnotations(pdf, domLinks) {
  const context = pdf.context;
  const structTreeRoot = context.lookup(
    pdf.catalog.get(PDFName.of("StructTreeRoot"))
  );
  const structLinks =
    structTreeRoot instanceof PDFDict
      ? collectLinkStructElems(structTreeRoot, context)
      : [];

  const byHref = new Map();
  for (const link of domLinks) {
    if (link.text && !byHref.has(link.href)) byHref.set(link.href, link.text);
  }

  // The two lists are the same links counted two ways, so their lengths
  // agreeing is the evidence that index i means the same anchor in both. When
  // they disagree -- a browser change, an anchor laid out in print and not on
  // screen -- fall back to matching on the URI rather than shifting every
  // description by one, which would be worse than the URI itself.
  const sameLength = structLinks.length === domLinks.length;
  const described = new Map();
  // Equal lengths are necessary and not sufficient: two lists of the same
  // size can still be in different orders. Every pair that carries a URI on
  // both sides is checked, and a single disagreement is enough to say the
  // descriptions are not trustworthy -- the per-pair fallback keeps that link
  // usable, but it must not do so silently.
  let mismatched = 0;

  structLinks.forEach((structLink, index) => {
    for (const ref of structLink.annots) {
      const annot = context.lookup(ref);
      if (!(annot instanceof PDFDict)) continue;
      const uri = linkUri(annot, context);
      let text = null;
      // The URI is checked per pair rather than across the whole list: one
      // anchor that fails to line up should cost one description, not all of
      // them.
      if (sameLength) {
        if (!uri || uri === domLinks[index].href) {
          text = domLinks[index].text;
        } else {
          mismatched += 1;
        }
      }
      if (!text && uri) text = byHref.get(uri) || null;
      if (text) described.set(annot, text);
    }
  });

  let fromText = 0;
  let fromUri = 0;
  for (const page of pdf.getPages()) {
    const annots = context.lookup(page.node.get(PDFName.of("Annots")));
    if (!(annots instanceof PDFArray)) continue;

    for (let i = 0; i < annots.size(); i += 1) {
      const annot = context.lookup(annots.get(i));
      if (!(annot instanceof PDFDict)) continue;

      const subtype = annot.get(PDFName.of("Subtype"));
      if (!(subtype instanceof PDFName) || subtype.asString() !== "/Link") continue;
      // Never overwrite a description the file already carries. Chromium
      // writes none today; a version that starts to knows more than this does.
      if (annot.get(PDFName.of("Contents"))) continue;

      const text = described.get(annot);
      const description =
        text || linkUri(annot, context) || linkDestination(annot, context);
      if (!description) continue;

      // Hex, not a literal string: a literal is PDFDocEncoded and a link
      // labelled with a curly quote or an accent would arrive mangled.
      annot.set(PDFName.of("Contents"), PDFHexString.fromText(description));
      if (text) fromText += 1;
      else fromUri += 1;
    }
  }

  // Both lists empty is a document with no links, which is aligned by
  // definition. ONE of them empty is not: a page full of anchors whose
  // structure tree has no /Link element is exactly the case worth hearing
  // about, and reporting it as aligned would suppress the only signal there
  // is.
  return {
    fromText,
    fromUri,
    aligned: sameLength && mismatched === 0,
    mismatched,
  };
}

// PDF/UA-1 7.2 t43: "Table rows shall have the same number of columns (taking
// into account column spans)". Chromium gives an empty <td> a layout box and
// tags only cells that have content, so the cell vanishes from the structure
// tree and its row comes up short by exactly the number of blanks in it.
//
// Measured on the CS 425 corpus, kanban-game.pdf table 0: rows=[5, 5, 4, 4, 2]
// against a source table that is five cells wide in every row. THE MARKDOWN IS
// NOT RAGGED; the tag tree is. A kanban column with two cards has three empty
// slots, and those slots are the figure.
//
// TWO CANDIDATE FIXES WERE MEASURED. THE CSS ONE DOES NOT WORK.
//
//   td:empty::before { content: "\00a0" }   rows unchanged: [5, 5, 4, 4, 2]
//   td:empty::before { content: "x" }       rows unchanged: [5, 5, 4, 4, 2],
//                                           and an "x" in every blank cell of
//                                           the extracted text layer
//
// So Chromium does not tag CSS-generated content in a cell at all, and the
// obvious cheap fix does not even make the checker go quiet. The second line
// is why no variant of it should be reached for either: a generated character
// visible enough to be tagged is visible enough to be copied. (The
// non-breaking space, measured, reaches neither the tag tree nor the text
// layer -- it is inert in both directions.)
//
// Measured asymmetry worth knowing: an empty <th> IS tagged, an empty <td> is
// not. Nothing below depends on that -- the alignment works it out per row --
// but it is why a blank corner header was never part of this failure.
//
// So the repair is structural, like the /LBody wrapping above it, and it says
// nothing new about the document: a cell the author wrote and left blank IS a
// cell. WHICH column it belongs to is the part the tag tree cannot supply,
// which is why the DOM's own row-and-cell layout is read before printing --
// appending the missing cells at the end of a short row would put the kanban
// board's blanks in the wrong columns and satisfy the checker while lying to
// the reader.

// Every table's cells, in document order, as the DOM has them.
async function collectTableCells(page) {
  return page.evaluate(() => {
    return Array.from(document.querySelectorAll("table")).map((table) =>
      Array.from(table.rows).map((row) =>
        Array.from(row.cells).map((cell) => ({
          header: cell.tagName === "TH",
          // An image-only cell has no text and is emphatically not blank, so
          // an element child counts as content. Getting this wrong cannot
          // corrupt anything: the per-row alignment below refuses to touch a
          // row whose tagged cells it cannot account for.
          blank: cell.childElementCount === 0 && !cell.textContent.trim(),
        }))
      )
    );
  });
}

// Every /Table in the structure tree, with its rows and each row's tagged
// cells. A stack rather than a single "current table", so a table nested in a
// cell does not silently steal the outer table's rows.
function collectTableStructure(structTreeRoot, context) {
  const tables = [];
  const seen = new Set();

  const visit = (ref, table, row) => {
    const node = context.lookup(ref);
    if (!node) return;

    if (node instanceof PDFArray) {
      for (let i = 0; i < node.size(); i += 1) visit(node.get(i), table, row);
      return;
    }
    if (!(node instanceof PDFDict)) return;
    if (seen.has(node)) return;
    seen.add(node);

    const structure = node.get(PDFName.of("S"));
    const name = structure instanceof PDFName ? structure.asString() : "";

    let nextTable = table;
    let nextRow = row;
    if (name === "/Table") {
      nextTable = { rows: [] };
      nextRow = null;
      tables.push(nextTable);
    } else if (name === "/TR" && nextTable) {
      nextRow = { node, ref, cells: [] };
      nextTable.rows.push(nextRow);
    } else if ((name === "/TD" || name === "/TH") && nextRow) {
      nextRow.cells.push({ node, ref });
    }

    visit(node.get(PDFName.of("K")), nextTable, nextRow);
  };

  visit(structTreeRoot.get(PDFName.of("K")), null, null);
  return tables;
}

// The scope an inserted header cell should carry, taken from a sibling in the
// same row rather than assumed. PDF/UA wants /Scope on a /TH and Chromium
// infers it from the table's shape, so copying the neighbour's answer is the
// only way to avoid contradicting it.
function scopeOfRow(row, context) {
  for (const cell of row.cells) {
    const attrs = context.lookup(cell.node.get(PDFName.of("A")));
    const dicts =
      attrs instanceof PDFArray
        ? attrs.asArray().map((entry) => context.lookup(entry))
        : [attrs];
    for (const dict of dicts) {
      if (!(dict instanceof PDFDict)) continue;
      const scope = dict.get(PDFName.of("Scope"));
      if (scope instanceof PDFName) return scope.asString().replace(/^\//, "");
    }
  }
  return "Column";
}

function tagEmptyTableCells(pdf, domTables) {
  const context = pdf.context;
  const structTreeRoot = context.lookup(
    pdf.catalog.get(PDFName.of("StructTreeRoot"))
  );
  if (!(structTreeRoot instanceof PDFDict)) return { inserted: 0, skipped: 0 };

  const structTables = collectTableStructure(structTreeRoot, context);
  // The two lists are the same tables counted two ways. If they disagree,
  // every index after the disagreement means a different table in each, so
  // nothing is touched -- a row of blanks put in the wrong columns is worse
  // than a row that is short.
  if (structTables.length !== domTables.length) {
    return { inserted: 0, skipped: structTables.length, aligned: false };
  }

  let inserted = 0;
  let skipped = 0;

  structTables.forEach((structTable, tableIndex) => {
    const domRows = domTables[tableIndex];
    if (structTable.rows.length !== domRows.length) {
      skipped += structTable.rows.length;
      return;
    }

    structTable.rows.forEach((structRow, rowIndex) => {
      const domCells = domRows[rowIndex];
      const tagged = structRow.cells;
      if (tagged.length === domCells.length) return;
      if (tagged.length > domCells.length) {
        skipped += 1;
        return;
      }

      // Walk the two lists together. A cell with content must have been
      // tagged; a blank one was tagged only if there are more tagged cells
      // left than there are remaining cells with content to account for them.
      // Deriving it this way rather than from "Chromium does not tag an empty
      // td" means a browser that changes its mind about which blanks it tags
      // is handled rather than mis-aligned.
      const remainingWithContent = [];
      let running = 0;
      for (let i = domCells.length - 1; i >= 0; i -= 1) {
        if (!domCells[i].blank) running += 1;
        remainingWithContent[i] = running;
      }

      const kids = [];
      const pending = [];
      let taken = 0;
      let usable = true;

      for (let i = 0; i < domCells.length && usable; i += 1) {
        const domCell = domCells[i];
        const taggedLeft = tagged.length - taken;
        if (!domCell.blank || taggedLeft > remainingWithContent[i]) {
          if (taggedLeft <= 0) {
            usable = false;
            break;
          }
          kids.push(tagged[taken].ref);
          taken += 1;
        } else {
          pending.push({ index: kids.length, domCell });
          kids.push(null);
        }
      }

      // Every tagged cell has to be accounted for, or the row is not
      // understood and is left exactly as it was.
      if (!usable || taken !== tagged.length) {
        skipped += 1;
        return;
      }

      const scope = scopeOfRow(structRow, context);
      for (const slot of pending) {
        const cell = context.obj({
          Type: "StructElem",
          S: slot.domCell.header ? "TH" : "TD",
        });
        const ref = context.register(cell);
        cell.set(PDFName.of("P"), structRow.ref);
        if (slot.domCell.header) {
          cell.set(PDFName.of("A"), context.obj({ O: "Table", Scope: scope }));
        }
        // No /K at all. The cell is empty, and an empty /K array or an
        // /ActualText would each claim something about content that is not
        // there -- the point of the element is that the cell EXISTS.
        kids[slot.index] = ref;
        inserted += 1;
      }

      structRow.node.set(PDFName.of("K"), context.obj(kids));
    });
  });

  return { inserted, skipped, aligned: true };
}

function xmpFor(title) {
  // pdfuaid:part is the identification PDF/UA-1 asks for. dc:title is carried
  // alongside it because the title is the one piece of metadata a reader
  // actually sees -- html-to-pdf already sets ViewerPreferences
  // /DisplayDocTitle, and a displayed title that is absent from the metadata
  // is a worse state than either alone.
  const escaped = String(title || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return `<?xpacket begin="﻿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description rdf:about="" xmlns:pdfuaid="http://www.aiim.org/pdfua/ns/id/">
      <pdfuaid:part>1</pdfuaid:part>
    </rdf:Description>
    <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">${escaped}</rdf:li></rdf:Alt></dc:title>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
<?xpacket end="w"?>`;
}

// PDF/UA 7.1: "Content shall be marked as Artifact or tagged as real content".
//
// Chromium wraps its text and its structural boxes in marked-content sequences
// -- /P <</MCID 3>>BDC ... EMC -- but paints some decoration outside all of
// them. Measured on a document with one table, there were exactly eight such
// operators in three groups:
//
//   1 1 1 rg  0 0 624 864 re f        the white page background
//   300 300 1950 2700 re W* n         a clip path, which paints nothing
//   1 115 311 34 re f  (x2)           the table header cells' shading
//
// All three are decoration by definition: a background, a clip, and cell
// shading. /Artifact is precisely the marker for "this paints, and it carries
// no meaning a reader needs", so the repair is to say so rather than to stop
// drawing them. Turning printBackground off would remove them and take the
// table shading, blockquote cards and slide title bars with it.
//
// Only DEPTH-0 runs are wrapped. Anything already inside a BDC belongs to a
// structure element and must not be re-marked; the depth counter is what keeps
// this from touching content that is already correct.

const PAINTING_OPERATORS = /\b(?:re|f\*?|F|S|s|B\*?|b\*?|n|W\*?|Do|sh|Tj|TJ|'|")\s*$/;

function markArtifacts(source) {
  const lines = source.split("\n");
  const out = [];
  let depth = 0;
  let run = [];
  let runPaints = false;

  const flush = () => {
    if (!run.length) return;
    // A run with no painting operator is graphics state -- colour, matrix, gs
    // -- and marking it would claim there is content where there is none.
    if (runPaints) {
      out.push("/Artifact BMC");
      out.push(...run);
      out.push("EMC");
    } else {
      out.push(...run);
    }
    run = [];
    runPaints = false;
  };

  for (const line of lines) {
    const t = line.trim();
    const opens = /\bBDC$|\bBMC$/.test(t);
    const closes = t === "EMC" || /\sEMC$/.test(t);

    if (opens) {
      flush();
      depth += 1;
      out.push(line);
      continue;
    }
    if (closes) {
      flush();
      depth = Math.max(0, depth - 1);
      out.push(line);
      continue;
    }
    if (depth > 0) {
      out.push(line);
      continue;
    }
    // q and Q bracket graphics state, not content. Breaking a run on them
    // keeps each /Artifact wholly inside one save/restore pair, so the
    // wrapper can never straddle a state change it does not own.
    if (t === "q" || t === "Q") {
      flush();
      out.push(line);
      continue;
    }
    run.push(line);
    if (PAINTING_OPERATORS.test(t)) runPaints = true;
  }
  flush();
  return out.join("\n");
}

async function markPageArtifacts(pdf) {
  const context = pdf.context;
  let wrapped = 0;

  for (const page of pdf.getPages()) {
    const contents = page.node.Contents();
    if (!contents) continue;

    // Contents is one stream or an array of them; both are legal and Chromium
    // emits one. Resolved through the context because either can be a
    // reference.
    const resolved = context.lookup(contents);
    const streams =
      resolved instanceof PDFArray
        ? resolved.asArray().map((ref) => context.lookup(ref))
        : [resolved];

    const rewritten = [];
    for (const stream of streams) {
      if (!(stream instanceof PDFRawStream)) {
        rewritten.push(stream);
        continue;
      }
      // decodePDFRawStream, not getContentsString. The latter exists and
      // returns the stream's RAW bytes -- still Flate-compressed -- so a
      // transform reading it finds no operators, changes nothing, and reports
      // success. That is exactly how the first attempt at this silently did
      // nothing while every test still passed.
      const before = Buffer.from(decodePDFRawStream(stream).decode()).toString(
        "latin1"
      );
      const after = markArtifacts(before);
      if (after === before) {
        rewritten.push(stream);
        continue;
      }
      // A fresh uncompressed stream rather than an edit in place: a
      // PDFRawStream owns its Length and Filter, and rewriting its bytes
      // without those would leave a stream that no reader can parse.
      rewritten.push(context.register(context.stream(after)));
      wrapped += 1;
    }

    if (wrapped) {
      page.node.set(
        PDFName.of("Contents"),
        rewritten.length === 1
          ? rewritten[0]
          : context.register(context.obj(rewritten))
      );
    }
  }
  return wrapped;
}

async function addPdfUaStructure(path, page) {
  const pdf = await PDFDocument.load(fs.readFileSync(path));
  const context = pdf.context;
  const catalog = pdf.catalog;

  const structTreeRoot = context.lookup(
    catalog.get(PDFName.of("StructTreeRoot"))
  );
  if (!(structTreeRoot instanceof PDFDict)) {
    // tagged: true is asserted by tests/test_pdf.py, so this means the PDF
    // came out untagged despite it -- a failure, not something to paper over.
    throw new Error("no structure tree; the PDF is untagged");
  }

  const nonStandard = new Set();
  collectStructureTypes(
    structTreeRoot.get(PDFName.of("K")),
    context,
    nonStandard,
    new Set()
  );

  const existing = context.lookup(structTreeRoot.get(PDFName.of("RoleMap")));
  const roleMap = existing instanceof PDFDict ? existing : context.obj({});
  for (const name of nonStandard) {
    // Span, not a guess at the semantics. A role map says which STANDARD type
    // a non-standard one stands in for, and Span is the generic inline
    // container -- Strong and Em carry emphasis that PDF has no structure type
    // for, and claiming a more specific one would assert something untrue
    // about the content.
    roleMap.set(PDFName.of(name), PDFName.of("Span"));
  }
  structTreeRoot.set(PDFName.of("RoleMap"), roleMap);

  const wrapped = wrapListBodies(structTreeRoot, context);
  const links = describeLinkAnnotations(pdf, page.links || []);
  const cells = tagEmptyTableCells(pdf, page.tables || []);
  const artifacts = await markPageArtifacts(pdf);

  const xmp = context.stream(xmpFor(pdf.getTitle()), {
    Type: "Metadata",
    Subtype: "XML",
  });
  catalog.set(PDFName.of("Metadata"), context.register(xmp));

  fs.writeFileSync(path, await pdf.save({ useObjectStreams: false }));
  return { mapped: Array.from(nonStandard).sort(), wrapped, links, cells, artifacts };
}

async function main() {
  const browser = await puppeteer.launch({
    executablePath: process.env.PUPPETEER_EXECUTABLE_PATH,
    args: [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
    ],
  });

  try {
    const page = await browser.newPage();

    // Defence in depth only. The stylesheet already makes it impossible for a
    // dark rule to reach print -- every one is sealed inside @media screen,
    // which print does not match -- and localStorage is empty in a fresh
    // profile, so the page resolves to whatever this reports anyway. Pinned
    // so a future Chromium default cannot quietly make that second argument
    // untrue.
    await page.emulateMediaFeatures([
      { name: "prefers-color-scheme", value: "light" },
    ]);

    page.on("requestfailed", (request) => {
      const failure = request.failure();
      failures.push(
        `${request.url()} (${failure ? failure.errorText : "request failed"})`,
      );
    });
    page.on("response", (response) => {
      if (response.status() >= 400) {
        failures.push(`${response.url()} (HTTP ${response.status()})`);
      }
    });
    page.on("pageerror", (error) => {
      failures.push(`uncaught page error: ${error.message}`);
    });

    await page.goto(`file:///workspace/${input}`, {
      waitUntil: "networkidle0",
      timeout: TIMEOUT_MS,
    });

    // Check before waiting on the page rather than only after. A page that
    // never sets the ready flag below would otherwise report "timed out" two
    // minutes later and bury the actual cause (a failed fetch, a thrown
    // script error).
    assertNoFailures();

    // Mermaid renders in the browser, and the tab panes are only assembled
    // once it signals done. Printing before this flag is set captures raw
    // mermaid source sitting in a code block and tab content that never got
    // moved into its pane.
    await page.waitForFunction("window.__mermaidReady === true", {
      timeout: TIMEOUT_MS,
    });

    // A webfont that is still loading lays out at fallback metrics, which
    // changes where every page break lands.
    await page.evaluate(() => document.fonts.ready.then(() => undefined));

    // Again, for anything that failed after the initial load settled.
    assertNoFailures();

    // Before printing, while the DOM is still there to read. page.pdf()
    // renders in print media, and this reads it in print media too, so a link
    // the print stylesheet hides is absent from both lists rather than one.
    const domLinks = await collectLinkText(page);
    const domTables = await collectTableCells(page);

    await page.pdf({
      path: output,
      // The @page rules in _page-style.css.j2 and _slide-style.css.j2 are the
      // page geometry: letter with 1in margins for documents, letter landscape
      // with one slide per page for decks. Without this, Puppeteer's own
      // defaults silently override both.
      preferCSSPageSize: true,
      // Honors the print-color-adjust: exact declarations on table headers,
      // row stripes, blockquotes, task-list checkboxes and slide title bars.
      printBackground: true,
      // The structure tree: headings, lists, tables and reading order, which
      // is what a screen reader navigates a PDF by. This is Puppeteer's own
      // default today, and stating it is the point -- an accessibility
      // property nothing asserts is one a version bump can remove silently,
      // and until stn-40n nothing in this repository looked at a PDF at all.
      // tests/test_pdf.py::test_the_pdf_is_tagged fails if this goes.
      tagged: true,
    });

    return { links: domLinks, tables: domTables };
  } finally {
    await browser.close();
  }
}

main()
  .then((facts) => addPdfUaStructure(output, facts))
  .then(({ mapped, wrapped, links, cells, artifacts }) => {
    const notes = [];
    if (mapped.length) notes.push(`role map: ${mapped.join(", ")} -> Span`);
    if (wrapped) notes.push(`${wrapped} list items wrapped in LBody`);
    if (links.fromText || links.fromUri) {
      notes.push(
        `${links.fromText + links.fromUri} link(s) described` +
          (links.fromUri ? ` (${links.fromUri} by URI)` : "")
      );
    }
    if (cells.inserted) notes.push(`${cells.inserted} empty table cell(s) tagged`);
    if (artifacts) notes.push(`${artifacts} content stream(s) artifact-marked`);
    console.log(`Wrote ${output}` + (notes.length ? ` (${notes.join("; ")})` : ""));
    if (cells.skipped) {
      // Loud, because a skipped row is a row that will still fail 7.2 t43 and
      // the reason is a shape this code did not recognise -- which is worth
      // hearing about while it is one table rather than a whole corpus.
      console.error(
        `${output}: ${cells.skipped} table row(s) could not be matched to the ` +
          "page's own tables and were left untouched."
      );
    }
    if (!links.aligned) {
      // Not fatal -- every link still carries a description -- but the good
      // ones came from the URI instead of the words, and that is worth saying
      // out loud rather than discovering in a PDF a year later.
      console.error(
        `${output}: the link structure elements and the page's anchors did ` +
          "not line up" +
          (links.mismatched
            ? ` (${links.mismatched} annotation(s) pointed somewhere their anchor did not)`
            : "") +
          ", so link descriptions fell back to their URIs."
      );
    }
  })
  .catch((error) => {
    console.error(`Failed to convert ${input}: ${error.message}`);
    for (const failure of failures) {
      console.error(`  ${failure}`);
    }
    process.exit(1);
  });
