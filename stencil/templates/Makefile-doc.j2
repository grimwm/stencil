format-md: ## Format markdown files
	@docker images -q docker.io/library/node:lts-alpine | grep -q . || $(DC) pull format-md
	$(DC) run --rm format-md

{% if has_pages %}
# with: Comma-separated features to include (e.g., with=hidden or with=hidden,draft)
WITH ?= $(with)

# Helper to define comma (must be before its use)
comma := ,

# Build metadata flags from WITH variable
METADATA_FLAGS := $(foreach feat,$(subst $(comma), ,$(WITH)),--metadata include-$(feat)=true)

# Build output suffix from WITH variable (e.g., -hidden or -hidden-draft)
OUTPUT_SUFFIX := $(if $(WITH),$(addprefix -,$(subst $(comma),-,$(WITH))),)

doc: format-md{% if has_slides %} slide{% endif %} ## Generate HTML{% if has_slides %} (documents and slide decks){% endif %} (use with=hidden to include hidden sections)
{% if has_docs %}
	@docker images -q docker.io/pandoc/core:latest | grep -q . || $(DC) pull doc
{% for md in docs %}
	$(DC) run --rm doc --metadata course="{{ name }}" $(METADATA_FLAGS) {{ md }} -o {{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).html
{% endfor %}
{% endif %}
	@echo "Generated docs$(if $(WITH), with features: $(WITH),)"

{% if has_slides %}
slide: format-md ## Generate HTML slide decks (use with=hidden to include presenter-only sections)
	@docker images -q docker.io/pandoc/core:latest | grep -q . || $(DC) pull slide
{% for md in slides %}
	$(DC) run --rm slide --metadata course="{{ name }}" $(METADATA_FLAGS) {{ md }} -o {{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).html
{% endfor %}
	@echo "Generated slides$(if $(WITH), with features: $(WITH),)"

{% endif %}
check-access: ## Check HTML accessibility (WCAG 2.1 AA)
	@docker images -q docker.io/library/node:lts-alpine | grep -q . || $(DC) pull check-access
	$(DC) run --rm check-access

{% endif %}
