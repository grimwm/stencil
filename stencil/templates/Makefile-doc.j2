format-md: ## Format markdown files
	$(call ensure_image,docker.io/library/node:lts-alpine,format-md)
	$(DC) run --rm format-md

{% if has_pages %}
# with: Comma-separated features to include (e.g., with=hidden or with=hidden,draft)
WITH ?= $(with)

# Helper to define comma (must be before its use)
comma := ,

# Build metadata flags from WITH variable
METADATA_FLAGS := $(foreach feat,$(subst $(comma), ,$(WITH)),--metadata include-$(feat)=true)

# The date a document carrying `show_date:` stamps itself with. Passed from
# here rather than read inside the container so the stamp is the build host's
# day, not the image's UTC one -- a handout generated at 7pm Central otherwise
# prints tomorrow's date. frontmatter-filter.lua falls back to its own
# os.date() when this is absent, so a hand-run pandoc still works.
BUILD_DATE ?= $(shell date +%F)

{% if has_package_output_dir %}
# Build products go somewhere other than beside the sources.
#
# Two mounts rather than one. Every path in this file is relative to the
# package directory mounted at /workspace, and an output directory that is a
# SIBLING of it cannot be reached from inside -- `-o ../build/foo.html` escapes
# the mount. So the output directory is mounted separately at /out and the
# paths below name it.
#
# The directory is created here rather than by the container: a bind mount to a
# path that does not exist is created by the daemon, owned by root, and then
# nothing on the host can write to it.
OUT := /out
OUT_HOST := {{ package_output_dir }}
{% else %}
# No output_dir: products land beside their sources, which is what every
# package that does not set the key has always done.
OUT := .
OUT_HOST := .
{% endif %}

.PHONY: out-dir
out-dir:
	@mkdir -p $(OUT_HOST)

# Build output suffix from WITH variable (e.g., -hidden or -hidden-draft)
OUTPUT_SUFFIX := $(if $(WITH),$(addprefix -,$(subst $(comma),-,$(WITH))),)

{% if has_pre_build %}
# pre_build: steps that must run BEFORE the documents build, as dependencies
# rather than as a prelude.
#
# WHY NOT JUST RUN THE COMMAND. cs425 generates sixteen SVGs from a matplotlib
# script; running it unconditionally on every `make doc` rewrites all sixteen
# even when nothing changed, because matplotlib output is not stable across
# versions. The real change then arrives buried in thousands of lines of diff.
# So the step is stale-checked, and "stale" has to include "gone".
#
# THE STAMP IS A MANIFEST, which is the part worth reading. A bare stamp records
# WHEN the command last ran and says nothing about whether its outputs still
# exist -- delete one SVG and the stamp is still newer than the script, so make
# reports nothing to do and the deck builds with a hole in it. Writing the
# produced filenames INTO the stamp means a missing one invalidates it, and it
# works with a glob, which an explicit list of sixteen names does not.
#
# WHERE IT RUNS: on the host, in the package directory, not in a container.
# Every other step here runs over /workspace, but a generator's environment is
# the author's business -- matplotlib today, something else next time -- and an
# image per generator is a large cost for a figure. Stencil supplies the
# dependency edge; the author supplies the runtime, and can put `docker run` in
# `run:` if they want one.
#
# Failure stops the build. A document built from stale figures is the defect
# being fixed, so a hook that cannot run must not be a warning.
{% for step in pre_build %}
{{ step.name | upper | replace('-', '_') }}_STAMP := .stencil-{{ step.name }}.stamp

.PHONY: {{ step.name }}
{{ step.name }}:
	@if [ -f $({{ step.name | upper | replace('-', '_') }}_STAMP) ]; then \
	    while read -r f; do \
	        [ -e "$$f" ] || { \
	            echo "{{ step.name }}: $$f is missing -- regenerating"; \
	            rm -f $({{ step.name | upper | replace('-', '_') }}_STAMP); \
	            break; \
	        }; \
	    done < $({{ step.name | upper | replace('-', '_') }}_STAMP); \
	fi
	@$(MAKE) --no-print-directory $({{ step.name | upper | replace('-', '_') }}_STAMP)

$({{ step.name | upper | replace('-', '_') }}_STAMP):{% for dep in step.inputs %} {{ dep }}{% endfor %}

	{{ step.run }}
	@ls -1d {% for out in step.outputs %}{{ out }} {% endfor %}> $@ 2>/dev/null || { \
	    echo "{{ step.name }}: produced none of {% for out in step.outputs %}{{ out }} {% endfor %}" >&2; \
	    rm -f $@; \
	    exit 1; \
	}

{% endfor %}
.PHONY: pre-build
pre-build:{% for step in pre_build %} {{ step.name }}{% endfor %}

{% endif %}
doc: out-dir{% if has_pre_build %} pre-build{% endif %} format-md{% if has_slides %} slide{% endif %} ## Generate HTML{% if has_docs and has_slides %} (documents and slide decks){% elif has_slides %} (slide decks){% endif %} (use with=hidden to include hidden sections)
{% if has_docs %}
	$(call ensure_image,{{ pandoc_image }},doc)
{% for md in docs %}
	$(DC) run --rm doc --metadata build-date="$(BUILD_DATE)" $(METADATA_FLAGS) {{ md }} -o $(OUT)/{{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).html
{% endfor %}
	@echo "Generated docs$(if $(WITH), with features: $(WITH),)"
{% endif %}

{% if has_slides %}
slide: out-dir{% if has_pre_build %} pre-build{% endif %} format-md ## Generate HTML slide decks (use with=hidden to include presenter-only sections)
	$(call ensure_image,{{ pandoc_image }},slide)
{% for md in slides %}
	$(DC) run --rm slide --metadata build-date="$(BUILD_DATE)" $(METADATA_FLAGS) {{ md }} -o $(OUT)/{{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).html
{% endfor %}
	@echo "Generated slides$(if $(WITH), with features: $(WITH),)"

{% endif %}
# Depends on doc, which already depends on slide, so `make pdf` always prints
# from HTML this run produced rather than whatever was left over from the last
# one. $(OUTPUT_SUFFIX) has to appear on both sides: `make pdf with=hidden`
# must print the -hidden HTML into the -hidden PDF, not pair one with the other.
pdf: doc ## Generate PDFs from the generated HTML (use with=hidden to include hidden sections)
	$(DC) build pdf
{% for md in docs + slides %}
	$(DC) run --rm pdf $(OUT)/{{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).html $(OUT)/{{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).pdf
{% endfor %}
	@echo "Generated PDFs$(if $(WITH), with features: $(WITH),)"

check-access: ## Check HTML accessibility (WCAG 2.1 AA)
	$(DC) build check-access
	$(DC) run --rm check-access

# Depends on pdf for the same reason check-access does not need to depend on
# doc: there is a file it is meaningless without. veraPDF exits 0 on an empty
# file list, so a check-pdf that ran before pdf would pass having checked
# nothing; the service refuses to, and this edge means it never has to.
# The filenames are passed rather than globbed. A package directory holds
# whatever anyone puts in it -- a third-party PDF in there used to fail the
# build, which is a red nobody can act on. This target already knows exactly
# what `pdf` above just wrote, suffix and all.
check-pdf: pdf ## Check PDF/UA-1 conformance of the generated PDFs
	$(DC) run --rm check-pdf{% for md in docs + slides %} $(OUT)/{{ md | replace('.md', '') }}$(OUTPUT_SUFFIX).pdf{% endfor %}

{% endif %}
