{# Shared client-side behavior: Bootstrap, highlight.js, Mermaid, tabbed sections.
   Libraries are inlined from stencil/assets/ rather than loaded from a CDN, so a
   generated page works offline and make pdf does not depend on the network.
   Mermaid uses the UMD build (globalThis.mermaid) rather than the ESM one: the
   ESM build lazily imports diagram chunks, which would reintroduce a fetch. #}
  <!-- Bootstrap JS Bundle -->
  <script>{{ assets.bootstrap_js }}</script>

  <!-- Highlight.js -->
  <script>{{ assets.highlight_js }}</script>
  <script>{{ assets.highlight_sql }}</script>
  <script>{{ assets.highlight_python }}</script>
  <script>{{ assets.highlight_javascript }}</script>
  <script>{{ assets.highlight_bash }}</script>
  <script>hljs.highlightAll();</script>

  <!-- Mermaid.js: run first; nav-tabs waits for mermaid-ready. Post-process SVG ids so multiple diagrams do not duplicate ids (WCAG 4.1.1). -->
  <script>{{ assets.mermaid_js }}</script>
  <script>
  (async function() {
    const mermaid = globalThis.mermaid;

    // Mermaid bakes its colours into the SVG at draw time, so CSS cannot
    // repaint a rendered diagram and a theme change has to redraw it. Reading
    // the palette from the live tokens rather than hardcoding a second one
    // keeps diagrams matching the page instead of approximating it.
    function themeVariables() {
      const css = getComputedStyle(document.documentElement);
      const token = (name) => css.getPropertyValue(name).trim();
      return {
        background: token('--surface'),
        primaryColor: token('--surface-accent'),
        primaryTextColor: token('--text'),
        primaryBorderColor: token('--accent'),
        secondaryColor: token('--surface-sunken'),
        tertiaryColor: token('--surface-muted'),
        lineColor: token('--text-muted'),
        textColor: token('--text'),
        mainBkg: token('--surface-accent'),
        nodeBorder: token('--accent'),
      };
    }

    // The source is gone once mermaid.run() replaces the element's contents
    // with SVG, so it is stashed before the first render and restored on every
    // one after it.
    document.querySelectorAll('pre code.language-mermaid, pre.mermaid').forEach((el) => {
      const pre = el.tagName === 'PRE' ? el : el.closest('pre');
      if (!pre) return;
      const text = (el.tagName === 'PRE' ? el : el).textContent.replace(/^\n|\n$$/g, '');
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.dataset.mermaidSource = text;
      div.textContent = text;
      pre.insertAdjacentElement('afterend', div);
      pre.remove();
    });

    async function renderMermaid() {
      const diagrams = document.querySelectorAll('.mermaid');
      if (!diagrams.length) return;
      diagrams.forEach((div) => {
        // A redraw has to undo the last one: restore the source and clear the
        // flag mermaid sets, or run() skips the element as already done.
        if (div.dataset.mermaidSource !== undefined) {
          div.textContent = div.dataset.mermaidSource;
        }
        delete div.dataset.processed;
        div.removeAttribute('data-processed');
      });
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: themeVariables(),
      });
      await mermaid.run({ querySelector: '.mermaid' });
      prefixSvgIds();
    }

    // Re-applied after every render: mermaid numbers ids from scratch each
    // time, so a second diagram would duplicate the first's (WCAG 4.1.1).
    function prefixSvgIds() {
      const mermaidContainers = document.querySelectorAll('.mermaid');
      if (mermaidContainers.length > 1) {
        document.querySelectorAll('.mermaid').forEach((container, i) => {
          const prefix = 'mermaid-' + i + '-';
          const svg = container.querySelector('svg');
          if (!svg) return;
          const idMap = {};
          svg.querySelectorAll('[id]').forEach((el) => {
            const oldId = el.getAttribute('id');
            if (oldId) {
              const newId = prefix + oldId;
              idMap[oldId] = newId;
              el.setAttribute('id', newId);
            }
          });
          function updateRef(attrValue) {
            if (!attrValue || !attrValue.startsWith('#')) return attrValue;
            const oldId = attrValue.slice(1);
            return idMap[oldId] !== undefined ? '#' + idMap[oldId] : attrValue;
          }
          function updateUrlRefs(val) {
            if (!val || !val.includes('url(#')) return val;
            return val.replace(/url\(#([^)]+)\)/g, (_, id) =>
              idMap[id] !== undefined ? 'url(#' + idMap[id] + ')' : 'url(#' + id + ')');
          }
          svg.querySelectorAll('[href]').forEach((el) => {
            const href = el.getAttribute('href');
            if (href) el.setAttribute('href', updateRef(href));
          });
          svg.querySelectorAll('*').forEach((el) => {
            const xhref = el.getAttributeNS('http://www.w3.org/1999/xlink', 'href');
            if (xhref) el.setAttributeNS('http://www.w3.org/1999/xlink', 'href', updateRef(xhref));
            ['fill', 'stroke', 'clip-path', 'mask', 'filter', 'style', 'marker-end', 'marker-start', 'marker-mid'].forEach((attr) => {
              const val = el.getAttribute(attr);
              if (val) {
                const updated = updateUrlRefs(val);
                if (updated !== val) el.setAttribute(attr, updated);
              }
            });
          });
        });
      }
    }

    await renderMermaid();

    // Set once, after the FIRST render, and never cleared. html-to-pdf.js
    // blocks on this flag; a redraw that reset it would hang the build.
    // Safe because a PDF build loads the page fresh with empty storage and
    // prefers-color-scheme forced light, so the theme never changes there
    // and the diagram is drawn exactly once -- the redraw path fires only
    // on a click, which cannot happen during a build.
    window.__mermaidReady = true;
    window.dispatchEvent(new Event('mermaid-ready'));

    // Redraw when the theme changes. Nothing above is repeated: the flag
    // stays set and the ready event is not fired again, so the tab code
    // and the PDF driver each see exactly one signal.
    if (window.__stencilTheme) {
      let firstCall = true;
      // Redraws are chained, not fired in parallel. renderMermaid() restores
      // each element's source and re-initializes mermaid globally, so two in
      // flight at once mutate the same nodes and the same config -- easy to
      // reach by clicking twice.
      let pending = Promise.resolve();
      window.__stencilTheme.subscribe(function () {
        // subscribe() calls back immediately with the current theme; the
        // diagram it would redraw has just been drawn.
        if (firstCall) { firstCall = false; return; }
        pending = pending.then(renderMermaid).catch(function () {});
      });
    }
  })();
  </script>

  <!-- Convert nav-tabs to Bootstrap tabs (after Mermaid to avoid moving nodes mid-render) -->
  <script>
  (function() {
    function initTabs() {
    const nav = document.querySelector('nav.nav-tabs');
    if (!nav) return;

    const container = document.querySelector('.container');
    const links = nav.querySelectorAll('a');
    if (links.length === 0) return;

    // Detect heading level from first link target
    const firstTargetId = links[0].getAttribute('href').slice(1);
    const firstTarget = document.getElementById(firstTargetId);
    if (!firstTarget) return;
    const headingTag = firstTarget.tagName;

    // Convert nav to Bootstrap format
    nav.className = 'nav nav-tabs problem-tabs';
    nav.setAttribute('role', 'tablist');

    // Create tab content container
    const tabContent = document.createElement('div');
    tabContent.className = 'tab-content';

    // Find all heading sections that match our tab links
    links.forEach((link, i) => {
      const targetId = link.getAttribute('href').slice(1);
      const heading = document.getElementById(targetId);
      if (!heading) return;

      // Setup the nav link
      link.className = 'nav-link' + (i === 0 ? ' active' : '');
      link.setAttribute('data-bs-toggle', 'tab');
      link.setAttribute('data-bs-target', '#tab-' + targetId);
      link.setAttribute('role', 'tab');
      link.setAttribute('aria-selected', i === 0 ? 'true' : 'false');

      // Create tab pane
      const pane = document.createElement('div');
      pane.className = 'tab-pane fade' + (i === 0 ? ' show active' : '');
      pane.id = 'tab-' + targetId;
      pane.setAttribute('role', 'tabpanel');

      // Collect all elements from heading until next heading of same level (or higher)
      let el = heading;
      const elements = [heading];
      const headingLevel = parseInt(headingTag.charAt(1));
      while (el.nextElementSibling) {
        const next = el.nextElementSibling;
        const nextTag = next.tagName;
        if (/^H[1-6]$$/.test(nextTag) && parseInt(nextTag.charAt(1)) <= headingLevel) {
          break;
        }
        el = next;
        elements.push(el);
      }

      // Move elements into pane
      elements.forEach(e => pane.appendChild(e));
      tabContent.appendChild(pane);
    });

    // Insert tab content after nav
    nav.parentNode.insertBefore(tabContent, nav.nextSibling);

    // Follow a URL fragment into whichever tab now owns it. Sections were moved into
    // hidden panes above, so the browser's own fragment scrolling cannot reach them and
    // a deep link would silently land on the first tab instead.
    function revealFragment() {
      var id = location.hash.slice(1);
      if (!id) return;
      var target = document.getElementById(decodeURIComponent(id));
      if (!target) return;
      var pane = target.closest('.tab-pane');
      if (!pane || pane.classList.contains('active')) {
        target.scrollIntoView();
        return;
      }
      var trigger = nav.querySelector('[data-bs-target="#' + pane.id + '"]');
      if (!trigger) return;
      // Wait for the pane to finish showing, otherwise it has no layout to scroll to.
      trigger.addEventListener('shown.bs.tab', function() { target.scrollIntoView(); }, { once: true });
      bootstrap.Tab.getOrCreateInstance(trigger).show();
    }

    window.addEventListener('hashchange', revealFragment);
    revealFragment();
    }
    if (window.__mermaidReady) {
      initTabs();
    } else {
      window.addEventListener('mermaid-ready', initTabs, { once: true });
    }
  })();
  </script>
