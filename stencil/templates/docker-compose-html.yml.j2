  format-md:
    image: docker.io/library/node:lts-alpine
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
    entrypoint:
      - sh
      - -c
      - |
        echo "Formatting markdown files..."
        npm install --prefix /tmp/fmt prettier @awmottaz/prettier-plugin-void-html && \
        /tmp/fmt/node_modules/.bin/prettier \
          --plugin /tmp/fmt/node_modules/@awmottaz/prettier-plugin-void-html/prettier-plugin-void-html.js \
          --prose-wrap always --print-width 100 --write "**/*.md"
    restart: "no"

  doc:
    image: docker.io/pandoc/core:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
      - --standalone
      - --template=html-template.html
      # A mistyped citation key is otherwise a console warning and a
      # "(**key?**)" in the page -- easy to miss, and it ships. Promote pandoc's
      # warnings to build failures instead. This catches unclosed fenced divs
      # too. It does not touch embed-images.lua's missing-figure notice, which
      # goes straight to stderr rather than through pandoc's warning system.
      - --fail-if-warnings
      - --lua-filter=hidden-filter.lua
      # Must follow hidden-filter. Citeproc collects a reference entry for every
      # citation it can still see, so running it first would list the sources an
      # answer key cites in the build that drops the answer key.
      - --citeproc
      - --lua-filter=mermaid-figure-filter.lua
      - --lua-filter=embed-images.lua
      - --mathml
    restart: "no"

{% if has_slides %}
  slide:
    image: docker.io/pandoc/core:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
      - --standalone
      - --template=slide-template.html
      # A mistyped citation key is otherwise a console warning and a
      # "(**key?**)" in the page -- easy to miss, and it ships. Promote pandoc's
      # warnings to build failures instead. This catches unclosed fenced divs
      # too. It does not touch embed-images.lua's missing-figure notice, which
      # goes straight to stderr rather than through pandoc's warning system.
      - --fail-if-warnings
      - --lua-filter=hidden-filter.lua
      # Between the two, and for two separate reasons. After hidden-filter, so a
      # presenter-only citation stays out of the handout's reference list; before
      # slide-sections, so the generated list is grouped into the last slide
      # rather than landing outside every card, where present mode never shows it.
      - --citeproc
      - --lua-filter=mermaid-figure-filter.lua
      - --lua-filter=embed-images.lua
      - --lua-filter=slide-sections.lua
      - --mathml
    restart: "no"

{% endif %}
  # Prints an already-generated HTML file to PDF. This is a stage after the
  # doc/slide services rather than a second pandoc pipeline: the @page and
  # @media print rules the HTML already carries are the page geometry, so the
  # PDF and the browser's own Ctrl+P produce the same document.
  #
  # Invoked as: docker compose run --rm pdf <input.html> <output.pdf>
  pdf:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - node
      - html-to-pdf.js
    restart: "no"

  # Shares the pdf service's image: both drive Chromium from Node, and building
  # one image for the pair keeps either from installing a browser at run time.
  check-access:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - sh
      - -c
      - |
        failed=0
        for f in *.html; do
          [ -f "$$f" ] || continue
          case "$$f" in html-template.html|slide-template.html) continue ;; esac
          echo "Checking $$f..."
          pa11y --config /opt/pa11y.json --standard WCAG2AA "file:///workspace/$$f" || failed=1
        done
        exit $$failed
    restart: "no"
