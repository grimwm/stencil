  format-md:
    image: docker.io/library/node:lts-alpine
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
    entrypoint:
      - sh
      - -c
      - |
        echo "Formatting markdown files..."
        npm install --prefix /tmp/fmt prettier @awmottaz/prettier-plugin-void-html && \
        /tmp/fmt/node_modules/.bin/prettier \
          --plugin /tmp/fmt/node_modules/@awmottaz/prettier-plugin-void-html/prettier-plugin-void-html.js \
          --prose-wrap always --print-width 100 --write "*.md"
    restart: "no"

  doc:
    image: docker.io/pandoc/core:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
      - --standalone
      - --template=html-template.html
      - --lua-filter=hidden-filter.lua
      # Must follow hidden-filter. Citeproc collects a reference entry for every
      # citation it can still see, so running it first would list the sources an
      # answer key cites in the build that drops the answer key.
      - --citeproc
      - --lua-filter=mermaid-figure-filter.lua
      - --lua-filter=embed-images.lua
      - --mathml
    restart: "no"

{% if has_slides %}
  slides:
    image: docker.io/pandoc/core:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
      - --standalone
      - --template=slides-template.html
      - --lua-filter=hidden-filter.lua
      # Between the two, and for two separate reasons. After hidden-filter, so a
      # presenter-only citation stays out of the handout's reference list; before
      # slide-sections, so the generated list is grouped into the last slide
      # rather than landing outside every card, where present mode never shows it.
      - --citeproc
      - --lua-filter=mermaid-figure-filter.lua
      - --lua-filter=embed-images.lua
      - --lua-filter=slide-sections.lua
      - --mathml
    restart: "no"

{% endif %}
  check-access:
    image: docker.io/library/node:lts-alpine
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
      - PUPPETEER_SKIP_DOWNLOAD=true
      - PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
    entrypoint:
      - sh
      - -c
      - |
        apk add --no-cache chromium > /dev/null 2>&1
        npm install --prefix /tmp/pa11y pa11y > /dev/null 2>&1
        cat > /tmp/pa11y.json << 'CONF'
        {
          "chromeLaunchConfig": {
            "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
          }
        }
        CONF
        failed=0
        for f in *.html; do
          [ -f "$$f" ] || continue
          case "$$f" in html-template.html|slides-template.html) continue ;; esac
          echo "Checking $$f..."
          /tmp/pa11y/node_modules/.bin/pa11y \
            --config /tmp/pa11y.json \
            --standard WCAG2AA \
            "file:///workspace/$$f" || failed=1
        done
        exit $$failed
    restart: "no"
