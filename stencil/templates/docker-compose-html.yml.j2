  format-md:
    image: docker.io/library/node:lts-alpine
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
    entrypoint:
      - sh
      - -c
      - |
        echo "Formatting markdown files..."
        npm install --prefix /tmp/fmt prettier @awmottaz/prettier-plugin-void-html && \
        /tmp/fmt/node_modules/.bin/prettier \
          --plugin /tmp/fmt/node_modules/@awmottaz/prettier-plugin-void-html/prettier-plugin-void-html.js \
          --prose-wrap always --print-width 100 --write "**/*.md"
    restart: "no"

{# The argv comes from stencil/pipeline.py so that a test can assert on the
   same list this file builds with. Do not inline it back here. #}
  doc:
    image: {{ pandoc_image }}
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
{% for arg, why in pandoc_argv_doc %}
{% if why %}
{% for line in why.split('\n') %}
      # {{ line }}
{% endfor %}
{% endif %}
      - {{ arg }}
{% endfor %}
    restart: "no"

{% if has_slides %}
  slide:
    image: {{ pandoc_image }}
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - pandoc
{% for arg, why in pandoc_argv_slide %}
{% if why %}
{% for line in why.split('\n') %}
      # {{ line }}
{% endfor %}
{% endif %}
      - {{ arg }}
{% endfor %}
    restart: "no"

{% endif %}
  # Prints an already-generated HTML file to PDF. This is a stage after the
  # doc/slide services rather than a second pandoc pipeline: the @page and
  # @media print rules the HTML already carries are the page geometry, so the
  # PDF and the browser's own Ctrl+P produce the same document.
  #
  # Invoked as: docker compose run --rm pdf <input.html> <output.pdf>
  pdf:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - node
      - html-to-pdf.js
    restart: "no"

  # Shares the pdf service's image: both drive Chromium from Node, and building
  # one image for the pair keeps either from installing a browser at run time.
  check-access:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    entrypoint:
      - sh
      - -c
      - |
        failed=0
        for f in *.html; do
          [ -f "$$f" ] || continue
          case "$$f" in html-template.html|slide-template.html) continue ;; esac
          # Both themes. The dark config clicks the theme control before
          # measuring, so this is the rendered dark page rather than a claim
          # about it -- and its contrast ratios are the ones nobody has looked
          # at, 0.11.0 having shipped a 3.88:1 label that looked fine.
          echo "Checking $$f (light)..."
          pa11y --config /opt/pa11y.json --standard WCAG2AA \
            "file:///workspace/$$f" || failed=1
          echo "Checking $$f (dark)..."
          pa11y --config /opt/pa11y-dark.json --standard WCAG2AA \
            "file:///workspace/$$f" || failed=1
        done
        exit $$failed
    restart: "no"
