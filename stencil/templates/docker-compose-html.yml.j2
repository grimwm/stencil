  # The image and the two packages are pinned in stencil/pipeline.py, alongside
  # the browser image's. An unpinned prettier is the widest blast radius of the
  # three floating installs stn-s5b found: it rewrites every markdown file in
  # the package, so a major landing between two runs reformats a course's whole
  # source tree and buries the actual edit.
  format-md:
    image: {{ node_image }}
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
    entrypoint:
      - sh
      - -c
      - |
        echo "Formatting markdown files..."
        npm install --prefix /tmp/fmt {{ format_npm_specs | join(' ') }} && \
        /tmp/fmt/node_modules/.bin/prettier \
          --plugin /tmp/fmt/node_modules/@awmottaz/prettier-plugin-void-html/prettier-plugin-void-html.js \
          --prose-wrap always --print-width 100 --write "**/*.md"
    restart: "no"

{# The argv comes from stencil/pipeline.py so that a test can assert on the
   same list this file builds with. Do not inline it back here. #}
  doc:
    image: {{ pandoc_image }}
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    entrypoint:
      - pandoc
{% for arg, why in pandoc_argv_doc %}
{% if why %}
{% for line in why.split('\n') %}
      # {{ line }}
{% endfor %}
{% endif %}
      - {{ arg }}
{% endfor %}
    restart: "no"

{% if has_slides %}
  slide:
    image: {{ pandoc_image }}
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    entrypoint:
      - pandoc
{% for arg, why in pandoc_argv_slide %}
{% if why %}
{% for line in why.split('\n') %}
      # {{ line }}
{% endfor %}
{% endif %}
      - {{ arg }}
{% endfor %}
    restart: "no"

{% endif %}
  # Prints an already-generated HTML file to PDF. This is a stage after the
  # doc/slide services rather than a second pandoc pipeline: the @page and
  # @media print rules the HTML already carries are the page geometry, so the
  # PDF and the browser's own Ctrl+P produce the same document.
  #
  # Invoked as: docker compose run --rm pdf <input.html> <output.pdf>
  pdf:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    entrypoint:
      - node
      - html-to-pdf.js
    restart: "no"

  # PDF/UA-1 (ISO 14289-1) conformance, which is a DIFFERENT STANDARD from the
  # WCAG 2.1 AA that check-access measures. pa11y reads the HTML; this reads
  # the PDF. A page can pass the first and produce a file that fails the
  # second -- <figure> wrappers are exactly that case, because HTML has no alt
  # on <figure> and WCAG has no rule asking for one.
  #
  # The image tag and the script both come from stencil/pipeline.py, so a test
  # runs the same text this file ships rather than an approximation of it. The
  # zero-file guard inside it is the reason it is a script: veraPDF exits 0
  # when it is given no files, so a check that ran too early would pass having
  # opened nothing. That rationale is written down at VERAPDF_SCRIPT.
  #
  # Every $ is doubled on the way in. Compose substitutes $VAR in a service
  # definition before the shell ever sees it, so an unescaped $found reaches
  # the script as the empty string and the guard silently stops guarding --
  # `[ "" -eq 0 ]` is not a comparison that fails safely. The escaping happens
  # here rather than in the constant so that pipeline.verapdf() can run the
  # same text directly through sh, where a doubled $ would be wrong.
  check-pdf:
    image: {{ verapdf_image }}
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    entrypoint:
      - sh
      - -c
      - |
{{ verapdf_script | replace('$', '$$') | indent(8, first=True) }}
      # $$0 for the script itself, so the filenames `make check-pdf` appends
      # land in "$$@". Without it the first filename would be swallowed as $$0
      # and silently go unchecked.
      - check-pdf
    restart: "no"

  # Shares the pdf service's image: both drive Chromium from Node, and building
  # one image for the pair keeps either from installing a browser at run time.
  check-access:
    build:
      context: .
      dockerfile: Dockerfile.browser
    image: localhost/{{ package_id }}_browser:latest
    volumes:
      - .:/workspace:z
{% if has_package_output_dir %}
      # Build products live outside the package directory, which the mount at
      # /workspace cannot reach: an output directory that is a sibling of the
      # sources is `..` away, and `..` escapes a bind mount. Mounted separately.
      - {{ package_output_dir }}:/out:z
{% endif %}
    working_dir: /workspace
    # The script comes from stencil/pipeline.py for the reason check-pdf's
    # does: a test runs the same text this file ships rather than a re-typed
    # approximation. It had to, in the end -- inlined here, the loop searched
    # /out and built its URL from /workspace, so check-access could not pass
    # at all for a package with an output_dir, and every test read this file's
    # text rather than running it.
    #
    # Every $ is doubled on the way in; compose substitutes $VAR in a service
    # definition before the shell sees it. The escaping happens here rather
    # than in the constant so the constant stays runnable directly through sh.
    entrypoint:
      - sh
      - -c
      - |
{{ check_access_script | replace('$', '$$') | indent(8, first=True) }}
      # $$0 for the script itself, then the directory to search as $$1. It is
      # absolute in both layouts, and the file:// URL is built from it, so
      # there is one path here rather than two that have to agree.
      - check-access
      - {% if has_package_output_dir %}/out{% else %}/workspace{% endif %}

    restart: "no"
