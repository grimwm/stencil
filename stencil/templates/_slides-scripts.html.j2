{# Deck behavior: slide counter, present mode, keyboard navigation.
   Progressive enhancement -- with JS off the deck is still a readable,
   printable stack of slide cards. #}
  <script>
  (function () {
    var root = document.documentElement;
    var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
    if (slides.length === 0) return;

    var index = 0;

    var toolbar = document.createElement('div');
    toolbar.className = 'deck-toolbar';
    toolbar.innerHTML =
      '<span class="deck-position" aria-live="polite"></span>' +
      '<button type="button" class="deck-present">Present</button>';
    document.body.appendChild(toolbar);

    var position = toolbar.querySelector('.deck-position');
    var button = toolbar.querySelector('.deck-present');

    function presenting() {
      return root.classList.contains('presenting');
    }

    function render() {
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-current', i === index);
      });
      position.textContent = (index + 1) + ' / ' + slides.length;
      if (presenting()) {
        slides[index].focus({ preventScroll: true });
      }
    }

    function go(delta) {
      var next = Math.min(slides.length - 1, Math.max(0, index + delta));
      if (next === index) return;
      index = next;
      render();
      if (!presenting()) {
        slides[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function start() {
      root.classList.add('presenting');
      button.textContent = 'Exit';
      render();
      if (document.body.requestFullscreen) {
        document.body.requestFullscreen().catch(function () { /* user gesture rules vary */ });
      }
    }

    function stop() {
      root.classList.remove('presenting');
      button.textContent = 'Present';
      render();
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(function () {});
      }
      slides[index].scrollIntoView({ block: 'start' });
    }

    button.addEventListener('click', function () {
      presenting() ? stop() : start();
    });

    document.addEventListener('fullscreenchange', function () {
      if (!document.fullscreenElement && presenting()) stop();
    });

    // Keep the counter honest while scrolling the deck as a document.
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        if (presenting()) return;
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var i = slides.indexOf(entry.target);
            if (i >= 0) {
              index = i;
              position.textContent = (index + 1) + ' / ' + slides.length;
            }
          }
        });
      }, { rootMargin: '-45% 0px -45% 0px' });
      slides.forEach(function (slide) { observer.observe(slide); });
    }

    slides.forEach(function (slide) { slide.tabIndex = -1; });

    document.addEventListener('keydown', function (event) {
      var target = event.target;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      switch (event.key) {
        case 'p':
        case 'P':
          event.preventDefault();
          presenting() ? stop() : start();
          return;
        case 'Escape':
          if (presenting()) { event.preventDefault(); stop(); }
          return;
      }

      if (!presenting()) return;

      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case 'PageDown':
        case ' ':
        case 'j':
          event.preventDefault();
          go(1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
        case 'PageUp':
        case 'k':
          event.preventDefault();
          go(-1);
          break;
        case 'Home':
          event.preventDefault();
          index = 0;
          render();
          break;
        case 'End':
          event.preventDefault();
          index = slides.length - 1;
          render();
          break;
      }
    });

    position.textContent = '1 / ' + slides.length;
  })();
  </script>
