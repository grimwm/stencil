{# Deck behavior: slide counter, present mode, keyboard navigation.
   Progressive enhancement -- with JS off the deck is still a readable,
   printable stack of slide cards. #}
  <script>
  (function () {
    var root = document.documentElement;
    var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
    if (slides.length === 0) return;

    var index = 0;

    var toolbar = document.createElement('div');
    toolbar.className = 'deck-toolbar';
    toolbar.innerHTML =
      '<span class="deck-position" aria-live="polite"></span>' +
      '<button type="button" class="deck-present">Present</button>';
    document.body.appendChild(toolbar);

    var position = toolbar.querySelector('.deck-position');
    var button = toolbar.querySelector('.deck-present');

    function presenting() {
      return root.classList.contains('presenting');
    }

    // --- Toolbar: draggable, and out of the way when idle ------------------
    //
    // The bar is pinned over the slide, so on a dense slide it can land on a
    // figure. Two answers, because they solve different halves: drag moves it
    // permanently, idle-hiding removes it during the part of a talk when
    // nobody is looking at it.

    var IDLE_AFTER_MS = 2600;
    var DRAG_THRESHOLD_PX = 4;

    // Where a drag puts the bar lasts for the life of the page and no longer.
    // It was persisted to localStorage at first, and that was wrong: the bar
    // gets moved to clear one crowded slide, and a viewer who opens the deck
    // the next day finds it parked somewhere they no longer remember choosing,
    // with nothing on screen explaining why. Reload is the obvious way to put
    // it back, and it should behave that way.
    var STORE_KEY = 'deck-toolbar-position';
    try {
      // Clear anything the persisting version left behind, so a viewer who
      // saw the old build is not stuck with its last saved corner forever.
      window.localStorage.removeItem(STORE_KEY);
    } catch (error) {
      /* Private windows and blocked site data throw on access. Nothing to
         clean up in that case anyway. */
    }

    var idleTimer = null;
    var dragging = false;

    function clamp(value, low, high) {
      return Math.min(Math.max(value, low), high);
    }

    // Keep the bar fully on screen: a position saved on a wide window must not
    // strand it off the edge of a narrow one.
    function placeAt(left, top) {
      var box = toolbar.getBoundingClientRect();
      var margin = 8;
      toolbar.style.left =
        clamp(left, margin, window.innerWidth - box.width - margin) + 'px';
      toolbar.style.top =
        clamp(top, margin, window.innerHeight - box.height - margin) + 'px';
      // `bottom` is the CSS default anchor; once dragged, `top` owns it.
      toolbar.style.bottom = 'auto';
    }


    function wake() {
      toolbar.classList.remove('is-idle');
      if (idleTimer) window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(function () {
        // Never vanish mid-drag, and never take the keyboard's focused
        // control out from under it.
        if (dragging || toolbar.contains(document.activeElement)) return;
        toolbar.classList.add('is-idle');
      }, IDLE_AFTER_MS);
    }

    ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart']
      .forEach(function (name) {
        document.addEventListener(name, wake, { passive: true });
      });
    toolbar.addEventListener('focusin', wake);

    toolbar.addEventListener('pointerdown', function (event) {
      // Let the button be a button. Dragging starts anywhere else on the bar.
      if (event.target.closest('button')) return;

      var box = toolbar.getBoundingClientRect();
      var grabX = event.clientX - box.left;
      var grabY = event.clientY - box.top;
      var startX = event.clientX;
      var startY = event.clientY;
      var moved = false;

      function onMove(moveEvent) {
        if (!moved) {
          // A threshold keeps a sloppy click from registering as a drag.
          if (Math.abs(moveEvent.clientX - startX) < DRAG_THRESHOLD_PX &&
              Math.abs(moveEvent.clientY - startY) < DRAG_THRESHOLD_PX) return;
          moved = true;
          dragging = true;
          toolbar.classList.add('is-dragging');
        }
        placeAt(moveEvent.clientX - grabX, moveEvent.clientY - grabY);
      }

      function onUp() {
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
        document.removeEventListener('pointercancel', onUp);
        dragging = false;
        toolbar.classList.remove('is-dragging');
        wake();
      }

      document.addEventListener('pointermove', onMove);
      document.addEventListener('pointerup', onUp);
      document.addEventListener('pointercancel', onUp);
    });

    window.addEventListener('resize', function () {
      if (toolbar.style.top) {
        placeAt(parseFloat(toolbar.style.left), parseFloat(toolbar.style.top));
      }
    });

    wake();

    function render() {
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-current', i === index);
      });
      position.textContent = (index + 1) + ' / ' + slides.length;
      if (presenting()) {
        slides[index].focus({ preventScroll: true });
      }
    }

    function go(delta) {
      var next = Math.min(slides.length - 1, Math.max(0, index + delta));
      if (next === index) return;
      index = next;
      render();
      if (!presenting()) {
        slides[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function start() {
      root.classList.add('presenting');
      button.textContent = 'Exit';
      render();
      if (document.body.requestFullscreen) {
        document.body.requestFullscreen().catch(function () { /* user gesture rules vary */ });
      }
    }

    function stop() {
      root.classList.remove('presenting');
      button.textContent = 'Present';
      render();
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(function () {});
      }
      slides[index].scrollIntoView({ block: 'start' });
    }

    button.addEventListener('click', function () {
      presenting() ? stop() : start();
    });

    document.addEventListener('fullscreenchange', function () {
      if (!document.fullscreenElement && presenting()) stop();
    });

    // Keep the counter honest while scrolling the deck as a document.
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        if (presenting()) return;
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var i = slides.indexOf(entry.target);
            if (i >= 0) {
              index = i;
              position.textContent = (index + 1) + ' / ' + slides.length;
            }
          }
        });
      }, { rootMargin: '-45% 0px -45% 0px' });
      slides.forEach(function (slide) { observer.observe(slide); });
    }

    slides.forEach(function (slide) { slide.tabIndex = -1; });

    document.addEventListener('keydown', function (event) {
      var target = event.target;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      switch (event.key) {
        case 'p':
        case 'P':
          event.preventDefault();
          presenting() ? stop() : start();
          return;
        case 'Escape':
          if (presenting()) { event.preventDefault(); stop(); }
          return;
      }

      if (!presenting()) return;

      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case 'PageDown':
        case ' ':
        case 'j':
          event.preventDefault();
          go(1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
        case 'PageUp':
        case 'k':
          event.preventDefault();
          go(-1);
          break;
        case 'Home':
          event.preventDefault();
          index = 0;
          render();
          break;
        case 'End':
          event.preventDefault();
          index = slides.length - 1;
          render();
          break;
      }
    });

    position.textContent = '1 / ' + slides.length;
  })();
  </script>
