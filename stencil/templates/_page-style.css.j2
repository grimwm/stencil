{# Shared page styling: typography, callouts, code, tables, figures, print rules.
   Included by html-template.html.j2 and slide-template.html.j2. #}
    :root {
      --font-serif: 'Crimson Pro', Georgia, 'Times New Roman', serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', 'Fira Code', Consolas, Monaco, monospace;
      --accent-color: #29417a;
      --card-bg: #fffdf5;
      --card-border: #c8b48c;
    }

    /* Academic fonts */
    body {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.7;
    }

    .container {
      max-width: 60rem;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    /* Document title. Outranks every heading beneath it -- see the heading
       block below, which has to state its own sizes for that to hold. */
    .doc-title {
      font-family: var(--font-sans);
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--accent-color);
    }

    /* Subordinate to the title, the way .deck-subtitle is on a title slide.
       font-weight is spelled out rather than left off: this div sits inside
       .doc-title, so an omitted weight inherits that block's 700 instead of
       falling back to normal. */
    .doc-subtitle {
      font-size: 1.4rem;
      font-weight: 400;
      color: #555;
      margin-top: 0.5rem;
    }

    /* What the document is worth, beside the title. Sits inside .doc-title,
       so like .doc-subtitle it has to opt out of that block's 2.2rem/700
       rather than inherit it -- a badge that outranks the title is the same
       inversion .doc-subtitle was fixed for, and the print block would carry
       it into the PDF.

       Colors are literal rather than tokens: there is no token layer to hang
       them on yet, and the theming release converts them along with the other
       fifty-odd in this file.

       No white-space: nowrap. A non-numeric `points` renders verbatim and can
       be long, and nowrap would push it past the page edge; the non-breaking
       space frontmatter-filter.lua puts between the number and its unit is
       what keeps "50 pts" together without forbidding a wrap. */
    .doc-points {
      display: inline-block;
      margin-left: 0.5rem;
      padding: 0.15em 0.55em;
      border-radius: 999px;
      background: #e8eef7;
      color: #29417a;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.4;
      overflow-wrap: anywhere;
      vertical-align: middle;
    }

    /* The header's two rows, as a grid rather than two flex rows.

       Grid because source order and visual order have to differ: the byline is
       written second so the author follows the subtitle for a screen reader
       and for pdftotext, and placement puts the context back up on row one.
       align-items: baseline so the course sits on the title's baseline rather
       than floating at the top of a two-line identity block.

       The context column is minmax(0, auto), not auto. A bare `auto` track
       refuses to shrink below its own min-content width, so a long brand or
       program beside the identity column's 18rem floor could push the header
       wider than the page -- the flex row this replaces would have wrapped
       instead. A zero minimum lets the context wrap inside its column, which
       is the behaviour worth keeping. */
    header.doc-title {
      display: grid;
      grid-template-columns: minmax(18rem, 1fr) minmax(0, auto);
      align-items: baseline;
      column-gap: 1.5rem;
      row-gap: 0.35rem;
    }

    /* The 18rem minimum is the wrap threshold the flex-basis used to be: once
       the title has less than that, the context drops to its own line rather
       than being squeezed to one word per line. */
    .doc-identity {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .doc-context {
      grid-column: 2;
      grid-row: 1;
    }

    .doc-byline {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 0.6rem;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 1.5rem;
    }

    /* Both right-hand columns push themselves over rather than relying on
       space-between, which would strand a lone date on the left. */
    .doc-context,
    .doc-date {
      margin-left: auto;
      text-align: right;
    }

    /* Byline: author(s) and date, from the front matter. Both of these sit
       inside .doc-title, so they have to opt out of that block's 2.2rem/700
       rather than inherit it. */
    .doc-meta,
    .doc-date,
    .doc-context {
      font-size: 1rem;
      font-weight: 400;
      color: #5a6270;
    }

    /* "Issued" and "Due" name which date is which. Two bare dates in one
       column cannot be told apart, and the build stamp went unlabelled until
       now only because it was the only one there. */
    .doc-date-label {
      font-weight: 600;
      color: #7a828f;
      margin-right: 0.3em;
    }

    .doc-due {
      margin-top: 0.15rem;
    }

    /* Brand: what the document belongs to, above the program it is part of.
       A name sits larger and darker than the context lines under it, so the
       institution reads as the parent of the course rather than another
       field beside it. */
    .doc-brand {
      font-size: 1.15rem;
      font-weight: 600;
      color: #3a424f;
      margin-bottom: 0.2rem;
    }

    /* A logo is capped on both axes, so a tall mark and a wide wordmark both
       fit without the header reflowing around whichever one was supplied.
       font-size: 0 on the box kills the line-box descender gap an inline
       image otherwise leaves beneath itself. */
    .doc-brand--image {
      font-size: 0;
      line-height: 0;
    }

    .doc-brand img {
      max-height: 2.75rem;
      max-width: 14rem;
      height: auto;
      width: auto;
    }

    /* Course and section share a line; the term takes its own. Separators are
       generated between siblings so no combination leaves a stray middot with
       nothing on one side of it. */
    .doc-context span + span::before {
      content: "\00b7";
      /* The whole gap, and symmetric: _doc-body.html.j2 emits these spans on
         one line precisely so no collapsed newline lands on one side. */
      margin: 0 0.4rem;
      color: #99a1b0;
    }

    .doc-term {
      display: block;
    }

    /* Two classes, so it outranks the sibling rule above without !important:
       the term starts a line, and a line does not open with a separator. */
    .doc-context .doc-term::before {
      content: none;
    }

    /* Narrow viewports: nothing is wide enough for two columns, so the header
       becomes the plain left-aligned stack it used to be -- now in source
       order, which finally puts the byline under the subtitle rather than
       after the context block.

       grid-row has to be reset alongside grid-column. Left at 1, identity and
       context would land in the same cell and overlap. */
    @media (max-width: 40rem) {
      header.doc-title {
        grid-template-columns: 1fr;
      }
      .doc-identity,
      .doc-context,
      .doc-byline {
        grid-column: 1;
        grid-row: auto;
      }
      .doc-context,
      .doc-date {
        margin-left: 0;
        text-align: left;
      }
    }

    /* Headings: sans-serif with accent borders.

       The sizes are stated here rather than inherited from Bootstrap, whose
       heading scale is viewport-relative -- calc(1.375rem + 1.5vw) -- so h1
       measured 39.4px against the title's 35.2px and grew with the window
       while the title stayed where it was. The steps track the print block's
       ratios against body text, so a heading keeps its rank in both media. */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-sans);
      font-weight: 600;
      margin-top: 2rem;
    }

    h1 {
      font-size: 1.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--accent-color);
    }

    h2 {
      font-size: 1.45rem;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid #dee2e6;
    }

    /* h4 lands on body size deliberately: below it a heading is told apart by
       weight and the sans face rather than by being bigger. */
    h3 { font-size: 1.25rem; }
    h4 { font-size: 1.125rem; }
    h5 { font-size: 1.05rem; }
    h6 { font-size: 1rem; }

    /* Blockquotes as callout cards */
    blockquote {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 1rem 1.25rem;
      margin-left: 3em;
      font-style: italic;
      font-size: inherit;
      box-shadow: 2px 2px 8px rgba(0,0,0,0.08);
    }

    blockquote p:last-child {
      margin-bottom: 0;
    }

    blockquote strong {
      font-style: normal;
      color: var(--accent-color);
    }

    /* Task lists: pandoc wraps each item as <li><label><input type=checkbox>text</label>.
       Drop the disc so the checkbox is the only marker, and hang the text off it
       so wrapped lines align with the first character instead of the box. */
    ul.task-list {
      list-style: none;
      padding-left: 0.25rem;
    }

    /* 0.25rem + 1.75rem is the 2rem Bootstrap indents a normal <ul> by, so
       task text starts on the same column as bullet text. rem, not em, for
       that reason -- Bootstrap's indent does not scale with font-size either. */
    ul.task-list > li {
      position: relative;
      padding-left: 1.75rem;
    }

    /* Absolute against the li: the label is inline and unpositioned, so the box
       sits in the hanging indent whether or not pandoc wrapped it in a label. */
    ul.task-list > li > input[type="checkbox"],
    ul.task-list > li > label > input[type="checkbox"] {
      position: absolute;
      left: 0;
      /* Baseline-align the box with the first line of serif body text. */
      top: 0.35em;
      margin: 0;
      width: 1em;
      height: 1em;
      /* Native control, so a checked box renders its tick in every browser and
         stays clickable on screen; accent-color just tints it to match. */
      accent-color: var(--accent-color);
    }

    /* Ordered task lists. Pandoc puts class="task-list" on a <ul> only -- an
       ordered one arrives as a bare <ol type="1"> carrying the very same
       <label><input type=checkbox> items -- so not one of the rules above can
       reach it. The box sat hard against the first letter with no gap, and
       printed unchecked, because both fixes were spelled `ul.task-list`.

       The ordinal is kept rather than replaced by the box the way a disc is:
       the author wrote an ordered list, so the number is content rather than
       decoration, and `1. [x]` should still say which item it is. That is the
       whole difference from the unordered case -- there is no hanging indent
       here, because the number already occupies that column. */
    ol > li > label > input[type="checkbox"],
    ol > li > input[type="checkbox"] {
      /* Both sides. The right gap is the reported bug -- text hard against
         the box -- but with only that, the box lands hard against the
         ordinal instead and the same complaint reads "1.[ ] text". */
      margin: 0 0.45em 0 0.35em;
      accent-color: var(--accent-color);
    }

    /* Code: mono font */
    code, pre {
      font-family: var(--font-mono);
    }

    pre {
      background: #f6f8fa;
      border: 1px solid #dee2e6;
      border-radius: 6px;
      padding: 1rem;
    }

    code {
      font-size: 0.875em;
      color: #c7254e;
    }

    pre code {
      color: inherit;
    }

    /* Highlight.js contrast fixes for WCAG 2.1 AA */
    .hljs-built_in { color: #c85200; }
    .hljs-string { color: #0550ae; }
    .hljs-symbol { color: #c85200; }

    /* Tables: header color, borders */
    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    /* Disable fixed layout for tables with 6+ columns */
    table:has(th:nth-child(6)) {
      table-layout: auto;
    }

    /* Override Pandoc's colgroup width calculations */
    col {
      width: auto !important;
    }

    table + table {
      margin-top: 1.5rem;
    }

    caption {
      font-family: var(--font-sans);
      font-weight: 600;
      text-align: left;
      padding: 0.5rem 0.75rem;
      caption-side: top;
      background: #e8eef7;
      border: 1px solid #c8c8c8;
      border-bottom: none;
    }

    thead {
      background: #d2def2;
    }

    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid #c8c8c8;
      text-align: left;
    }

    th {
      font-family: var(--font-sans);
      font-weight: 600;
    }

    tbody tr:nth-child(even) {
      background: #f5f7fa;
    }

    /* Display math: block + centered */
    math[display="block"] {
      display: block;
      text-align: center;
      margin: 1rem 0;
    }

    /* Figures (e.g. Mermaid with figcaption) */
    figure {
      margin: 1.5rem auto;
      text-align: center;
    }
    figure figcaption {
      text-align: center;
      margin-top: 0.5rem;
      font-size: 0.95em;
      color: #555;
      white-space: normal;
    }

    /* Mermaid diagrams (client-side render) */
    .mermaid {
      margin: 1.5rem 0;
      overflow-x: auto;
      min-width: 200px;
      min-height: 100px;
    }

    /* Side-by-side tables */
    .side-by-side {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .side-by-side table {
      width: auto;
      margin: 0;
    }

    /* Navigation tabs - Bootstrap overrides */
    .nav-tabs.problem-tabs {
      background: var(--accent-color);
      border-radius: 6px 6px 0 0;
      border: none;
      padding: 0.5rem 0.5rem 0;
      margin-bottom: 0;
    }

    .nav-tabs.problem-tabs .nav-link {
      color: rgba(255,255,255,0.85);
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 500;
      border: none;
      border-radius: 6px 6px 0 0;
      padding: 0.5rem 1rem;
      margin-right: 2px;
    }

    .nav-tabs.problem-tabs .nav-link:hover {
      color: #fff;
      background: rgba(255,255,255,0.15);
    }

    .nav-tabs.problem-tabs .nav-link.active {
      background: #fff;
      color: var(--accent-color);
      border: none;
    }

    .tab-content {
      border: 1px solid #dee2e6;
      border-top: none;
      border-radius: 0 0 6px 6px;
      padding: 1.5rem;
      background: #fff;
    }

    .tab-pane h1:first-child,
    .tab-pane h2:first-child {
      margin-top: 0;
      border-bottom: none;
      padding-bottom: 0;
    }

    /* Print styles */
    @media print {
      @page {
        size: letter;
        margin: 1in;
      }

      /* One type scale, two media. Every size above is in rem, and a rem is
         the root font size -- so print rescales the root once and the whole
         scale follows, instead of restating each size in pt and inverting the
         moment one is forgotten.

         9.78pt keeps body, at 1.125rem, on the 11pt it has always printed at.
         Screen leaves the root alone: pinning it there would override the
         reader's own font-size preference, which print has no equivalent of. */
      html {
        font-size: 9.78pt;
      }

      body {
        line-height: 1.5;
      }

      .container {
        max-width: 100%;
        padding: 0;
      }


      h1, h2, h3, h4, h5, h6 {
        page-break-after: avoid;
      }

      pre, blockquote, table, figure {
        page-break-inside: avoid;
      }

      pre {
        font-size: 0.92rem;
      }

      table {
        font-size: 1.02rem;
      }

      thead {
        background: #e8e8e8 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      tbody tr:nth-child(even) {
        background: #f5f5f5 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      blockquote {
        background: #fffef8 !important;
        box-shadow: none;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* A logo is the one image in the header, and a header that prints
         without it is a handout that looks unbranded on paper only. */
      .doc-brand img {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Browsers drop form-control fills from print by default, which would
         print a checked box as an empty one. Not scoped to ul.task-list:
         an ordered task list has no such class, and its checked boxes were
         printing empty for exactly that reason. */
      li input[type="checkbox"] {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Show all tab panes and hide nav tabs when printing */
      .nav-tabs.problem-tabs {
        display: none !important;
      }

      .tab-content {
        border: none;
        padding: 0;
      }

      .tab-pane {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
      }

      .tab-pane + .tab-pane {
        margin-top: 1.5rem;
      }
    }
