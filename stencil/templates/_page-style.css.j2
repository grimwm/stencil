{# Shared page styling: typography, callouts, code, tables, figures, print rules.
   Included by html-template.html.j2 and slide-template.html.j2. #}
    /* The light palette, and the only unconditional definition of it. Dark
       values live in exactly one place -- an @media screen block at the foot
       of this file -- because print cannot match that block, so these values
       apply to every printed page with nothing to undo.

       Every colour in this file and in _slide-style.css.j2 is one of these
       tokens. A hardcoded colour is a value that escapes theming: right in
       light, wrong in dark, and invisible to a suite that reads structure.
       tests/test_theme.py fails on one. */
    :root {
      /* Light unless the sealed block below says otherwise, so print -- which
         cannot match @media screen -- always gets light UA widgets. */
      color-scheme: light;

      --font-serif: 'Crimson Pro', Georgia, 'Times New Roman', serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', 'Fira Code', Consolas, Monaco, monospace;

      /* Surfaces */
      --surface: #fff;
      --surface-sunken: #f6f8fa;
      --surface-muted: #f5f7fa;
      --surface-accent: #e8eef7;
      --surface-accent-on: #d2def2;

      /* Text. Every one of these is measured against --surface in
         tests/test_theme.py; the Issued/Due label already shipped once at
         3.88:1 and had to be raised. */
      --text: #212529;
      --text-subtle: #555;
      --text-muted: #5a6270;
      --text-label: #687080;
      --text-strong: #3a424f;
      --text-faint: #6b7280;

      /* Lines */
      --border: #dee2e6;
      --border-muted: #c8c8c8;

      /* Accent, and what sits on top of it */
      /* Two roles, two tokens. --accent is ink: text, borders, rules, and it
         has to be legible ON a surface. --accent-fill is a background that
         --on-accent text sits on. They are the same colour in light, which is
         exactly why one token survived until dark mode made --accent light
         and every filled control turned white-on-pale -- the deck's Present
         button measured 2.35:1. */
      --accent: #29417a;
      --accent-fill: #29417a;
      --card-accent: var(--accent);
      --on-accent: #fff;
      --on-accent-muted: rgba(255, 255, 255, 0.85);
      --on-accent-bright: rgba(255, 255, 255, 0.9);
      --on-accent-faint: rgba(255, 255, 255, 0.5);
      --on-accent-fill: rgba(255, 255, 255, 0.15);

      /* Callout card */
      --card-bg: #fffdf5;
      --card-border: #c8b48c;

      /* Code */
      --code-inline: #c7254e;
      --hl-builtin: #c85200;
      --hl-string: #0550ae;

      --shadow-card: rgba(0, 0, 0, 0.08);
      --focus-ring: #ffbf47;

      /* Deck tokens. Defined here rather than in _slide-style.css.j2 because
         a deck includes this file, so there is one :root, not two. */
      --deck-surface: #fff;
      --deck-border: #d8dee9;
      --deck-shadow: rgba(20, 30, 60, 0.10);
      --deck-shadow-md: rgba(20, 30, 60, 0.16);
      --deck-shadow-lg: rgba(20, 30, 60, 0.26);
      --deck-counter: #8a93a5;
      --deck-accent-from: #29417a;
      --deck-accent-to: #3c5da8;
      --deck-accent-edge: #22335e;
      --deck-body-text: #2c3444;
      --deck-quote-bg: #eef2fb;
      --deck-quote-border: #c3cfe8;
      --deck-toolbar-bg: rgba(255, 255, 255, 0.94);
      --deck-toolbar-border: #ccd4e2;
      --deck-toolbar-fg: #55607a;
      --deck-toolbar-hover: #1d2f5c;
      --deck-presenting-bg: #e9edf4;

      /* Print-only, and deliberately not the screen values. These are their
         own tokens rather than literals so the drift guard can stay absolute:
         every colour in the file is a token, with no exemption to remember. */
      --print-th-bg: #e8e8e8;
      --print-stripe-bg: #f5f5f5;
      --print-card-bg: #fffef8;
      --print-deck-bg: #29417a;
      --print-deck-fg: #fff;
      --print-deck-quote-bg: #eef2fb;
    }

    /* Academic fonts */
    body {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.7;
    }

    /* Bold, stated rather than inherited.

       Bootstrap's reboot says `b, strong { font-weight: bolder }`, which is
       RELATIVE: it resolves against whatever the parent carries. That is fine
       in prose at 400 and wrong everywhere else -- inside .doc-label at 600 it
       asks for 700, and inside a heading at 700 it asks for 900, a weight no
       family here ships. Naming 700 makes every <strong> the same weight
       wherever it sits.

       This is only half the reason bold looked weak. The other half was that
       Crimson Pro was vendored at 400 and 600 ONLY, so a request for 700 found
       no face at or above it and the browser fell back to 600 -- SemiBold
       beside Regular, in a serif, at body size.

       800, and measured rather than picked. Advance width of "the quick brown
       fox" at 18px: 400 -> 142.6, 600 -> 149.1, 700 -> 152.8, 800 -> 156.8.
       Bold used to render as that 600, so 700 would have added 2.5% to a step
       already too small to read as emphasis. 900 measures identical to 800,
       so this is the end of the family's ladder rather than a value to keep
       pushing.

       Changing this number alone does nothing. Only the weights listed in
       scripts/vendor_page_assets.py exist as files, and a request for a weight
       nobody ships fails silently -- the browser picks the nearest face and
       the page looks almost right, which is exactly how this shipped in the
       first place. tests/test_fonts.py fails if the two ever disagree. */
    strong,
    b {
      font-weight: 800;
    }

    .container {
      max-width: 60rem;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    /* Document title. Outranks every heading beneath it -- see the heading
       block below, which has to state its own sizes for that to hold. */
    .doc-title {
      font-family: var(--font-sans);
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--accent);
    }

    /* The title's h1 carries no styling of its own -- .doc-title above is
       where the type is set. This cancels the user-agent h1 so adding the
       element changed nothing visible: without it, an h1 brings its own
       2em size and block margins and the header grows. */
    .doc-name {
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      margin: 0;
    }

    /* Subordinate to the title, the way .deck-subtitle is on a title slide.
       font-weight is spelled out rather than left off: this div sits inside
       .doc-title, so an omitted weight inherits that block's 700 instead of
       falling back to normal. */
    .doc-subtitle {
      font-size: 1.4rem;
      font-weight: 400;
      font-style: italic;
      color: var(--text-subtle);
      /* Tight to the title. A subtitle belongs to the line above it, and half
         a rem of air read as two unrelated headings rather than one unit. */
      margin-top: 0.15rem;
    }


    /* The header's two rows, as a grid rather than two flex rows.

       Grid because source order and visual order have to differ: the byline is
       written second so the author follows the subtitle for a screen reader
       and for pdftotext, and placement puts the context back up on row one.
       align-items: baseline so the course sits on the title's baseline rather
       than floating at the top of a two-line identity block.

       The context column is minmax(0, auto), not auto. A bare `auto` track
       refuses to shrink below its own min-content width, so a long brand or
       program beside the identity column's 18rem floor could push the header
       wider than the page -- the flex row this replaces would have wrapped
       instead. A zero minimum lets the context wrap inside its column, which
       is the behaviour worth keeping. */
    header.doc-title {
      display: grid;
      grid-template-columns: minmax(18rem, 1fr) minmax(0, auto);
      align-items: baseline;
      column-gap: 1.5rem;
      row-gap: 0.35rem;
    }

    /* The 18rem minimum is the wrap threshold the flex-basis used to be: once
       the title has less than that, the context drops to its own line rather
       than being squeezed to one word per line. */
    .doc-identity {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .doc-context {
      grid-column: 2;
      grid-row: 1;
    }

    /* Two stacked lines, not two columns: authors above, facts below.

       An author list is the reason. Side by side, six names squeeze the facts
       into a column too narrow to spread, and the two wrap into each other at
       exactly the widths a project handout uses. Given the full width each,
       a long author list simply takes another line and the facts keep their
       own. */
    .doc-byline {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 0.6rem;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.3rem;
    }

    /* Both right-hand columns push themselves over rather than relying on
       space-between, which would strand a lone date on the left. */
    .doc-context {
      margin-left: auto;
      text-align: right;
    }

    /* Byline and context, from the front matter. All of these sit inside
       .doc-title, so they have to opt out of that block's 2.2rem/700 rather
       than inherit it -- and .doc-facts has to be named here even though
       its children set their own size, because a flex container's own
       font-size still raises a 2.2rem strut and pads the row to 60px for a
       27px line. */
    .doc-meta,
    .doc-facts,
    .doc-context {
      font-size: 1rem;
      font-weight: 400;
      color: var(--text-muted);
    }

    /* "Author", "Issued" and "Due" name which byline field is which. Two
       bare dates in one column cannot be told apart, and once they are
       labelled an unlabelled author is the odd one out. */
    .doc-label {
      font-weight: 600;
      /* 4.98:1 on white. The muted grey this started at, #7a828f, was 3.88:1
         -- under AA for text this size, and `make check-access` runs pa11y at
         WCAG 2.1 AA. A label naming which date you are looking at is not
         decoration, so it takes the text threshold rather than the 3:1 one. */
      color: var(--text-label);
      margin-right: 0.3em;
    }


    /* Brand: what the document belongs to, above the program it is part of.
       A name sits larger and darker than the context lines under it, so the
       institution reads as the parent of the course rather than another
       field beside it. */
    .doc-brand {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text-strong);
      margin-bottom: 0.2rem;
    }

    /* A logo is capped on both axes, so a tall mark and a wide wordmark both
       fit without the header reflowing around whichever one was supplied.
       font-size: 0 on the box kills the line-box descender gap an inline
       image otherwise leaves beneath itself. */
    .doc-brand--image {
      font-size: 0;
      line-height: 0;
    }

    .doc-brand img {
      max-height: 2.75rem;
      max-width: 14rem;
      height: auto;
      width: auto;
    }

    /* Course and section share a line; the term takes its own. Separators are
       generated between siblings so no combination leaves a stray middot with
       nothing on one side of it. */
    .doc-context span + span::before {
      /* The spaces are in the content, not the margin. A generated middot
         with margin either side paints a gap and puts no whitespace glyph in
         the text layer, so the context line extracted from the PDF as
         "001\00b7Fall 2026" -- the same defect as the byline, one layer down,
         and the one place where there is no text node to move a space into.

         The gap is held at what it was rather than allowed to tighten. Each
         side used to be 0.4rem of pure margin; a non-breaking space measures
         0.28em at this font, so 0.12em of margin is the remainder. Measured
         in the browser image at letter print width and at a 420px screen, the
         rendered gap either side of the middot is unchanged to within 0.05px.

         Symmetric, and _doc-body.html.j2 emits these spans on one line
         precisely so no collapsed newline lands on one side. */
      content: "\00a0\00b7\00a0";
      margin: 0 0.12em;
      color: var(--text-faint);
    }

    /* A section belongs to its program, so it joins with a full stop and no
       gap -- "CS 425.001" reads as one identifier -- while the term stays a
       separate fact behind the middot. Two classes, so this outranks the
       sibling rule above without !important. */
    .doc-context .doc-section::before {
      content: ".";
      margin: 0;
      color: inherit;
    }

    /* Narrow viewports: nothing is wide enough for two columns, so the header
       becomes the plain left-aligned stack it used to be -- now in source
       order, which finally puts the byline under the subtitle rather than
       after the context block.

       grid-row has to be reset alongside grid-column. Left at 1, identity and
       context would land in the same cell and overlap. */
    @media (max-width: 40rem) {
      header.doc-title {
        grid-template-columns: 1fr;
      }
      .doc-identity,
      .doc-context,
      .doc-byline {
        grid-column: 1;
        grid-row: auto;
      }
      .doc-context {
        margin-left: 0;
        text-align: left;
      }
      /* Stacked, the facts have no blank space to spread into, so they close
         up behind their separators instead of drifting apart. */
      .doc-facts {
        justify-content: flex-start;
        gap: 0.45rem;
      }
    }

    /* Headings: sans-serif with accent borders.

       The sizes are stated here rather than inherited from Bootstrap, whose
       heading scale is viewport-relative -- calc(1.375rem + 1.5vw) -- so h1
       measured 39.4px against the title's 35.2px and grew with the window
       while the title stayed where it was. The steps track the print block's
       ratios against body text, so a heading keeps its rank in both media. */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-sans);
      font-weight: 600;
      margin-top: 2rem;
    }

    h1 {
      font-size: 1.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--accent);
    }

    h2 {
      font-size: 1.45rem;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
    }

    /* h4 lands on body size deliberately: below it a heading is told apart by
       weight and the sans face rather than by being bigger. */
    h3 { font-size: 1.25rem; }
    h4 { font-size: 1.125rem; }
    h5 { font-size: 1.05rem; }
    h6 { font-size: 1rem; }

    /* Blockquotes as callout cards */
    blockquote {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 1rem 1.25rem;
      margin-left: 3em;
      font-style: italic;
      font-size: inherit;
      box-shadow: 2px 2px 8px var(--shadow-card);
    }

    blockquote p:last-child {
      margin-bottom: 0;
    }

    blockquote strong {
      font-style: normal;
      color: var(--accent);
    }

    /* Task lists: pandoc wraps each item as <li><label><input type=checkbox>text</label>.
       Drop the disc so the checkbox is the only marker, and hang the text off it
       so wrapped lines align with the first character instead of the box. */
    ul.task-list {
      list-style: none;
      padding-left: 0.25rem;
    }

    /* 0.25rem + 1.75rem is the 2rem Bootstrap indents a normal <ul> by, so
       task text starts on the same column as bullet text. rem, not em, for
       that reason -- Bootstrap's indent does not scale with font-size either. */
    ul.task-list > li {
      position: relative;
      padding-left: 1.75rem;
    }

    /* Absolute against the li: the label is inline and unpositioned, so the box
       sits in the hanging indent whether or not pandoc wrapped it in a label. */
    ul.task-list > li > input[type="checkbox"],
    ul.task-list > li > label > input[type="checkbox"] {
      position: absolute;
      left: 0;
      /* Baseline-align the box with the first line of serif body text. */
      top: 0.35em;
      margin: 0;
      width: 1em;
      height: 1em;
      /* Native control, so a checked box renders its tick in every browser and
         stays clickable on screen; accent-color just tints it to match. */
      accent-color: var(--accent);
    }

    /* Ordered task lists. Pandoc puts class="task-list" on a <ul> only -- an
       ordered one arrives as a bare <ol type="1"> carrying the very same
       <label><input type=checkbox> items -- so not one of the rules above can
       reach it. The box sat hard against the first letter with no gap, and
       printed unchecked, because both fixes were spelled `ul.task-list`.

       The ordinal is kept rather than replaced by the box the way a disc is:
       the author wrote an ordered list, so the number is content rather than
       decoration, and `1. [x]` should still say which item it is. That is the
       whole difference from the unordered case -- there is no hanging indent
       here, because the number already occupies that column. */
    ol > li > label > input[type="checkbox"],
    ol > li > input[type="checkbox"] {
      /* Both sides. The right gap is the reported bug -- text hard against
         the box -- but with only that, the box lands hard against the
         ordinal instead and the same complaint reads "1.[ ] text". */
      margin: 0 0.45em 0 0.35em;
      accent-color: var(--accent);
    }

    /* Code: mono font */
    code, pre {
      font-family: var(--font-mono);
    }

    pre {
      background: var(--surface-sunken);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
    }

    code {
      font-size: 0.875em;
      color: var(--code-inline);
    }

    pre code {
      color: inherit;
    }

    /* Highlight.js contrast fixes for WCAG 2.1 AA */
    .hljs-built_in { color: var(--hl-builtin); }
    .hljs-string { color: var(--hl-string); }
    .hljs-symbol { color: var(--hl-builtin); }

    /* Tables: header color, borders */
    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    /* Disable fixed layout for tables with 6+ columns */
    table:has(th:nth-child(6)) {
      table-layout: auto;
    }

    /* Override Pandoc's colgroup width calculations */
    col {
      width: auto !important;
    }

    table + table {
      margin-top: 1.5rem;
    }

    caption {
      font-family: var(--font-sans);
      font-weight: 600;
      text-align: left;
      padding: 0.5rem 0.75rem;
      caption-side: top;
      background: var(--surface-accent);
      border: 1px solid var(--border-muted);
      border-bottom: none;
    }

    thead {
      background: var(--surface-accent-on);
    }

    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--border-muted);
      text-align: left;
    }

    th {
      font-family: var(--font-sans);
      font-weight: 600;
    }

    tbody tr:nth-child(even) {
      background: var(--surface-muted);
    }

    /* Display math: block + centered */
    math[display="block"] {
      display: block;
      text-align: center;
      margin: 1rem 0;
    }

    /* Figures (e.g. Mermaid with figcaption) */
    figure {
      margin: 1.5rem auto;
      text-align: center;
    }

    /* Theme variants for embedded images, paired by embed-images.lua when a
       -dark sibling exists beside a figure. Declared here, outside any media
       query, so the dark variant is hidden EVERYWHERE by default -- print
       included. The rule that shows it lives in the @media screen block at the
       foot of this file, which print cannot match, so a PDF gets the light
       figure with nothing to configure and nothing to undo.

       Writing it the other way round -- :root:not([data-theme="dark"]) here --
       would read as equivalent and is not: a reader who has chosen dark and
       then prints has data-theme="dark" on the page, and the dark figure would
       print on a white sheet. */
    .doc-img--dark {
      display: none;
    }
    figure figcaption {
      text-align: center;
      margin-top: 0.5rem;
      font-size: 0.95em;
      color: var(--text-subtle);
      white-space: normal;
    }

    /* Mermaid diagrams (client-side render) */
    .mermaid {
      margin: 1.5rem 0;
      overflow-x: auto;
      min-width: 200px;
      min-height: 100px;
    }

    /* Side-by-side tables */
    .side-by-side {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .side-by-side table {
      width: auto;
      margin: 0;
    }

    /* Navigation tabs - Bootstrap overrides */
    .nav-tabs.problem-tabs {
      background: var(--accent-fill);
      border-radius: 6px 6px 0 0;
      border: none;
      padding: 0.5rem 0.5rem 0;
      margin-bottom: 0;
    }

    .nav-tabs.problem-tabs .nav-link {
      color: var(--on-accent-muted);
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 500;
      border: none;
      border-radius: 6px 6px 0 0;
      padding: 0.5rem 1rem;
      margin-right: 2px;
    }

    .nav-tabs.problem-tabs .nav-link:hover {
      color: var(--on-accent);
      background: var(--on-accent-fill);
    }

    .nav-tabs.problem-tabs .nav-link.active {
      background: var(--surface);
      color: var(--accent);
      border: none;
    }

    .tab-content {
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0 0 6px 6px;
      padding: 1.5rem;
      background: var(--surface);
    }

    .tab-pane h1:first-child,
    .tab-pane h2:first-child {
      margin-top: 0;
      border-bottom: none;
      padding-bottom: 0;
    }

    /* Print styles */
    @media print {
      @page {
        size: letter;
        margin: 1in;
      }

      /* One type scale, two media. Every size above is in rem, and a rem is
         the root font size -- so print rescales the root once and the whole
         scale follows, instead of restating each size in pt and inverting the
         moment one is forgotten.

         9.78pt keeps body, at 1.125rem, on the 11pt it has always printed at.
         Screen leaves the root alone: pinning it there would override the
         reader's own font-size preference, which print has no equivalent of. */
      html {
        font-size: 9.78pt;
      }

      body {
        line-height: 1.5;
      }

      .container {
        max-width: 100%;
        padding: 0;
      }


      h1, h2, h3, h4, h5, h6 {
        page-break-after: avoid;
      }

      pre, blockquote, table, figure {
        page-break-inside: avoid;
      }

      pre {
        font-size: 0.92rem;
      }

      table {
        font-size: 1.02rem;
      }

      thead {
        background: var(--print-th-bg) !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      tbody tr:nth-child(even) {
        background: var(--print-stripe-bg) !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      blockquote {
        background: var(--print-card-bg) !important;
        box-shadow: none;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* A logo is the one image in the header, and a header that prints
         without it is a handout that looks unbranded on paper only. */
      .doc-brand img {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Browsers drop form-control fills from print by default, which would
         print a checked box as an empty one. Not scoped to ul.task-list:
         an ordered task list has no such class, and its checked boxes were
         printing empty for exactly that reason. */
      li input[type="checkbox"] {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Show all tab panes and hide nav tabs when printing */
      .nav-tabs.problem-tabs {
        display: none !important;
      }

      .tab-content {
        border: none;
        padding: 0;
      }

      .tab-pane {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
      }

      .tab-pane + .tab-pane {
        margin-top: 1.5rem;
      }
    }

    /* Dark, and the only place in either stylesheet that may be.

       @media screen is the entire print guarantee. Print does not match it,
       so none of this reaches the print formatter and the light :root values
       above apply to every printed page. That is why no light value is
       re-declared for print anywhere: there is nothing to undo. Move one
       declaration out of this wrapper and every handout prints dark.

       System resolution happens in JS -- _page-head.html.j2 writes a resolved
       light/dark to data-theme -- rather than through a prefers-color-scheme
       variant here, so this palette is written once instead of twice.

       tests/test_theme.py holds three things about this block: that nothing
       theme-conditional escapes the wrapper, that it defines exactly the
       token names :root does, and that every text colour clears 4.5:1
       against --surface. */
    @media screen {
      :root[data-theme="dark"] {
        color-scheme: dark;

        --surface: #1b1f27;
        --surface-sunken: #22262f;
        --surface-muted: #202631;
        --surface-accent: #24304a;
        --surface-accent-on: #2f4680;

        --text: #e3e6ea;
        --text-subtle: #c2c8d2;
        --text-muted: #a8b0bd;
        --text-label: #aab2bf;
        --text-strong: #f0f2f5;
        --text-faint: #8b94a3;

        --border: #333a46;
        --border-muted: #3d4552;

        --accent: #8fa9e0;
        --accent-fill: #2f4680;
        --card-accent: var(--accent);
        --on-accent: #fff;
        --on-accent-muted: rgba(255, 255, 255, 0.85);
        --on-accent-bright: rgba(255, 255, 255, 0.9);
        --on-accent-faint: rgba(255, 255, 255, 0.55);
        --on-accent-fill: rgba(255, 255, 255, 0.18);

        /* The callout keeps its warmth rather than going flat grey; it is a
           cream card in light, so a warm dark reads as the same element. */
        --card-bg: #232016;
        --card-border: #5c5031;

        --code-inline: #ff9ab0;
        --hl-builtin: #ffa657;
        --hl-string: #a5d6ff;

        --shadow-card: rgba(0, 0, 0, 0.5);
        --focus-ring: #ffbf47;

        --deck-surface: #1b1f27;
        --deck-border: #333a46;
        --deck-shadow: rgba(0, 0, 0, 0.45);
        --deck-shadow-md: rgba(0, 0, 0, 0.55);
        --deck-shadow-lg: rgba(0, 0, 0, 0.65);
        --deck-counter: #8b94a3;
        --deck-accent-from: #223258;
        --deck-accent-to: #2f4680;
        --deck-accent-edge: #16203a;
        --deck-body-text: #e3e6ea;
        --deck-quote-bg: #22293a;
        --deck-quote-border: #39445c;
        --deck-toolbar-bg: rgba(27, 31, 39, 0.94);
        --deck-toolbar-border: #3d4552;
        --deck-toolbar-fg: #a8b0bd;
        --deck-toolbar-hover: #3f5da8;
        --deck-presenting-bg: #14171c;

        /* Bootstrap, mapped from our own tokens rather than through
           data-bs-theme. Bootstrap's dark block lives inside the vendored
           bootstrap.min.css and is NOT wrapped in @media screen, so setting
           that attribute would put a second dark mechanism in the page that
           print cannot switch off -- and we would be back to re-asserting
           values and hoping specificity holds. These are the variables these
           pages actually surface: the container, tables and the tab strip. */
        --bs-body-bg: var(--surface);
        --bs-body-color: var(--text);
        --bs-emphasis-color: var(--text-strong);
        --bs-border-color: var(--border);
        --bs-secondary-bg: var(--surface-sunken);
        --bs-tertiary-bg: var(--surface-muted);
        /* Bootstrap 5.3 resolves links through --bs-link-color-rgb, not
           --bs-link-color: `a { color: rgba(var(--bs-link-color-rgb), ...) }`.
           Setting the wrong one left every link at Bootstrap's light-mode
           #0d6efd on a dark page -- 3.67:1, which pa11y caught. */
        --bs-link-color-rgb: 143, 169, 224;
        --bs-link-hover-color-rgb: 143, 169, 224;
        --bs-link-color: var(--accent);
        --bs-link-hover-color: var(--accent);
        --bs-code-color: var(--code-inline);
        --bs-table-color: var(--text);
        --bs-table-bg: transparent;
        --bs-table-border-color: var(--border);
        --bs-table-striped-color: var(--text);
        --bs-table-striped-bg: var(--surface-sunken);
      }

      /* The image-variant swap. Placed after the token block, not before it:
         tests/test_theme.py reads the FIRST :root[data-theme="dark"] rule
         in this block as the palette, so a component rule above it makes
         that helper measure the wrong thing.

         `inline` rather than `revert` or `initial`: nothing in either
         stylesheet sets a display on an image, so inline is what the light one
         already has. A `revert` here would discard any author rule a later
         release adds. */
      :root[data-theme="dark"] .doc-img--light {
        display: none;
      }
      :root[data-theme="dark"] .doc-img--dark {
        display: inline;
      }

    }

    /* The theme control. Fixed on a document, and re-parented into the
       toolbar on a deck -- see _slide-scripts.html.j2 -- so these rules cover
       both and the deck stylesheet adds only what the toolbar needs. */
    .theme-toggle {
      display: inline-flex;
      gap: 0.125rem;
      padding: 0.15rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      font-family: var(--font-sans);
    }

    .theme-toggle-host {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 10;
    }

    .theme-toggle__option {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2rem;
      min-height: 1.9rem;
      padding: 0 0.4rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1;
      cursor: pointer;
    }

    /* The pressed segment is a filled chip rather than a tinted one: it
       reads as pressed at a glance, and it puts --on-accent on
       --accent-fill, a pair the contrast test holds at 4.5:1 in both
       palettes. The tinted version measured 2.67:1 on the deck toolbar,
       whose own translucent background pa11y cannot composite. */
    .theme-toggle__option[aria-checked="true"] {
      background: var(--accent-fill);
      color: var(--on-accent);
    }

    .theme-toggle__option:focus-visible {
      outline: 3px solid var(--focus-ring);
      outline-offset: 1px;
    }

    /* Visually hidden, not absent. The glyph is aria-hidden, so this is the
       control's entire accessible name -- display: none would leave three
       buttons announcing nothing. */
    .theme-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    @media print {
      /* A control that cannot be operated on paper is furniture. */
      .theme-toggle,
      .theme-toggle-host {
        display: none !important;
      }
    }

    /* Issued, Due and Points on one line, spread across whatever horizontal
       space the author leaves. space-between rather than a fixed gap: the
       point is to use the width, and the separators are real elements so they
       are spaced with everything else rather than hugging the item after
       them.

       flex: 1 with min-width: 0 so a long author shortens this group instead
       of pushing it off the page. */
    .doc-facts {
      min-width: 0;
      /* display: flex is load-bearing beyond layout. Its children blockify,
         which is what puts a boundary between "Sep 05" and the next fact's
         label in the accessibility tree -- the fact separators are
         aria-hidden, so they contribute no whitespace of their own. Change
         this to inline flow and the facts line runs together for a screen
         reader, silently, the way the author list did before 0.13.0. */
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.35rem 0.5rem;
    }

    .doc-fact {
      white-space: nowrap;
    }

    /* Laid out as inline text rather than a flex row. Inline content wraps
       between names on its own, and the spaces between them are real
       characters -- a flex gap paints the space but leaves nothing to copy,
       so the header reads "AuthorAda Lovelace" in a paste or a pdftotext. */
    .doc-author {
      white-space: nowrap;
    }

    .doc-author-sep {
      color: var(--text-faint);
    }

    .doc-fact-sep {
      color: var(--text-faint);
    }
