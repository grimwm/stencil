# Makefile for course activities
# Compose, from this directory: $(DC){% for f in compose_files %} -f {{ f }}{% endfor %}

# Override to use another Compose implementation, e.g. DC="podman compose"
DC ?= docker compose

ifneq ($(filter -%,$(DC)),)
$(error DC names a compose implementation only, e.g. DC="podman compose"; compose files belong in COMPOSE_FILES)
endif

ifeq ($(strip $(DC)),)
$(error DC must name a compose implementation, e.g. DC="podman compose")
endif

# The compose file(s) every invocation below pins, so that a
# docker-compose.override.yml or a .env COMPOSE_FILE sitting in the package
# directory is never auto-discovered and merged by compose's own resolution.
# A consumer who genuinely wants such a file merged in still can --
# by naming it explicitly, e.g.
# `make doc COMPOSE_FILES="docker-compose.yml docker-compose.override.yml"`.
COMPOSE_FILES ?= {{ compose_files | join(' ') }}

ifeq ($(strip $(COMPOSE_FILES)),)
$(error COMPOSE_FILES must name at least one compose file, e.g. COMPOSE_FILES=docker-compose.yml)
endif

ifeq ($(origin COMPOSE_FILES),environment)
$(error COMPOSE_FILES from the environment is ignored; pass it on the make command line)
endif

_stencil_pin_check = $(if $(strip $(DC)),,$(error DC must name a compose implementation -- e.g. DC="podman compose"))$(if $(strip $(COMPOSE_FILES)),,$(error COMPOSE_FILES must name at least one compose file -- e.g. COMPOSE_FILES=docker-compose.yml))$(if $(filter -%,$(DC)),$(error DC names a compose implementation only -- e.g. DC="podman compose" -- and compose files belong in COMPOSE_FILES))

# No --project-directory. Docker Compose v2's default project directory is the
# parent of the first -f file, and podman-compose resolves bind sources from
# that same directory. --project-directory is a Compose v2 flag podman-compose
# 1.x rejects, which is what made `make pdf` and `make format-md` exit 2
# when `docker` is the podman shim. Relative paths in the generated Compose
# files are written from that directory (`.stencil/`), so `..` is the package
# root for both tools.
STENCIL_COMPOSE = $(_stencil_pin_check)$(DC) $(addprefix -f ,$(COMPOSE_FILES))

override STENCIL_CONTAINER = $(firstword $(subst -, ,$(DC)))

# Pull an image only when it is not already present. Four targets want this and
# the two shells share no spelling of it, so it lives here rather than as four
# copies of the same ifeq: cmd, which is what make runs recipes through on
# Windows, has no grep.
ifeq ($(OS),Windows_NT)
ensure_image = @powershell -NoProfile -Command "$(STENCIL_CONTAINER) image inspect '$(1)' *> $$null; if ($$LASTEXITCODE -ne 0) { $(STENCIL_COMPOSE) pull $(2) }"
else
ensure_image = @$(STENCIL_CONTAINER) image inspect '$(1)' >/dev/null 2>&1 || $(STENCIL_COMPOSE) pull $(2)
endif

# Default target
ifeq ($(OS),Windows_NT)
help: ## Show this help message
	@echo Compose, from this directory: $(STENCIL_COMPOSE)
	@echo Available targets:
	@powershell -NoProfile -Command "Get-Content $(MAKEFILE_LIST) | Select-String '^[a-zA-Z0-9_-]+:.*?## .*$$' | ForEach-Object { $$_ -match '^([a-zA-Z0-9_-]+):.*?## (.*)$$' | Out-Null; '  {0,-15} {1}' -f $$matches[1], $$matches[2] } | Select-Object -Unique"
else
help: ## Show this help message
	@echo "Compose, from this directory: $(STENCIL_COMPOSE)"
	@echo "Available targets:"
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}' | uniq
endif
