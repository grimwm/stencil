# Makefile for course activities
# Compose, from this directory: $(DC){% for f in compose_files %} -f {{ f }}{% endfor %}

# Override to use another Compose implementation, e.g. DC="podman compose"
DC ?= docker compose

ifneq ($(filter -%,$(DC)),)
$(error DC names a compose implementation only, e.g. DC="podman compose"; compose files belong in COMPOSE_FILES)
endif

ifeq ($(strip $(DC)),)
$(error DC must name a compose implementation, e.g. DC="podman compose")
endif

# The compose file(s) every invocation below pins, so that a
# docker-compose.override.yml or a .env COMPOSE_FILE sitting in the package
# directory is never auto-discovered and merged by compose's own resolution.
# A consumer who genuinely wants such a file merged in still can --
# by naming it explicitly, e.g.
# `make doc COMPOSE_FILES="docker-compose.yml docker-compose.override.yml"`.
COMPOSE_FILES ?= {{ compose_files | join(' ') }}

ifeq ($(strip $(COMPOSE_FILES)),)
$(error COMPOSE_FILES must name at least one compose file, e.g. COMPOSE_FILES=docker-compose.yml)
endif

ifeq ($(origin COMPOSE_FILES),environment)
$(error COMPOSE_FILES from the environment is ignored; pass it on the make command line)
endif

_stencil_pin_check = $(if $(strip $(DC)),,$(error DC must name a compose implementation -- e.g. DC="podman compose"))$(if $(strip $(COMPOSE_FILES)),,$(error COMPOSE_FILES must name at least one compose file -- e.g. COMPOSE_FILES=docker-compose.yml))$(if $(filter -%,$(DC)),$(error DC names a compose implementation only -- e.g. DC="podman compose" -- and compose files belong in COMPOSE_FILES))

# Relative binds in the generated files are written from `.stencil/`, which is
# where podman-compose always resolves them (the first -f file's directory).
# Docker Compose v2 instead resolves them from its project directory, and that
# defaults to the shell's cwd -- the package root -- so `..` would leave the
# package. `--project-directory .stencil` puts Docker on the same base.
# podman-compose 1.x does not accept the flag and exits 2 if it is passed, so
# this asks `--help` and adds it only when the chosen DC implements it.
# The probe is `--help` only. The only flag it can add is the constant below.
ifeq ($(OS),Windows_NT)
_compose_has_project_dir := $(shell $(DC) --help 2>NUL | findstr /C:"--project-directory" >NUL && echo yes)
else
_compose_has_project_dir := $(shell $(DC) --help 2>&1 | grep -q -- --project-directory && echo yes)
endif
ifeq ($(_compose_has_project_dir),yes)
STENCIL_COMPOSE = $(_stencil_pin_check)$(DC) --project-directory .stencil $(addprefix -f ,$(COMPOSE_FILES))
else
STENCIL_COMPOSE = $(_stencil_pin_check)$(DC) $(addprefix -f ,$(COMPOSE_FILES))
endif

override STENCIL_CONTAINER = $(firstword $(subst -, ,$(DC)))

# One-shot `compose run` creates a project network, and `run --rm` removes
# only the container. Docker Desktop's default address pools hold about
# thirty of those networks, so a tree of packages exhausts them and the next
# run fails with "all predefined address pools have been fully subnetted".
# Each one-shot therefore takes a project of its own. -p overrides the name
# written into the compose file, so `down` of this project removes its
# network and cannot see a stack that is up under the file's own name.
# The service name is part of the project so two one-shots in one package do
# not share a network. The EXIT trap covers a failed run. The status is saved
# first because a successful down would otherwise become the shell's status.
# Arguments after the call are the service's own argv, which keeps a comma in
# one of them from being read as another argument to `call`.
# podman-compose's down stops every service named in the file, then prints
# "Error: no container ..." for each one this one-shot never started. Those
# lines are not a failed build (down still exits 0). Drop them, and a real
# line from down still reaches the terminal. The saved status is unchanged.
# -T: podman-compose otherwise warns that stdin is not a terminal.
# On Windows, make starts the recipe with CreateProcess. trap is not a
# program there, so `make format-md` dies with "The system cannot find the
# file specified". PowerShell runs the same one-shot and downs the project
# afterwards. Arguments after the call follow the literal --.
STENCIL_ONCE_PROJECT = {{ compose_project }}
ifeq ($(OS),Windows_NT)
compose_once = powershell -NoProfile -ExecutionPolicy Bypass -File .stencil/compose-once.ps1 $(STENCIL_ONCE_PROJECT)-$(1) $(1) $(STENCIL_COMPOSE) --
else
compose_once = trap 'rc=$$?; out=$$($(STENCIL_COMPOSE) -p $(STENCIL_ONCE_PROJECT)-$(1) down --remove-orphans 2>&1) || rc=$$?; printf "%s\n" "$$out" | grep -v -e "no container with" -e "no such container" -e "no pod with" -e "no such pod" | grep -v "^$$" >&2 || true; exit $$rc' EXIT; $(STENCIL_COMPOSE) -p $(STENCIL_ONCE_PROJECT)-$(1) run -T --rm $(1)
endif

# Pull an image only when it is not already present. Four targets want this and
# the two shells share no spelling of it, so it lives here rather than as four
# copies of the same ifeq: cmd, which is what make runs recipes through on
# Windows, has no grep.
ifeq ($(OS),Windows_NT)
ensure_image = @powershell -NoProfile -Command "$(STENCIL_CONTAINER) image inspect '$(1)' *> $$null; if ($$LASTEXITCODE -ne 0) { $(STENCIL_COMPOSE) pull $(2) }"
else
ensure_image = @$(STENCIL_CONTAINER) image inspect '$(1)' >/dev/null 2>&1 || $(STENCIL_COMPOSE) pull $(2)
endif

# Default target
ifeq ($(OS),Windows_NT)
# Windows PowerShell 5.1 binds one positional argument of Get-Content. The
# second makefile name is "A positional parameter cannot be found", and that
# is the whole of `make` once a package includes a fragment -- every package
# does. Quoted and comma-separated, the list is one array and -LiteralPath
# reads every fragment. Recursive (`=`), not `:=`: the includes after this
# partial are still unread when this line is parsed, and the recipe reads
# the list when it runs.
_help_empty :=
_help_space := $(_help_empty) $(_help_empty)
_help_comma := ,
_help_quote := '
STENCIL_HELP_FILES = $(subst $(_help_space),$(_help_comma),$(foreach f,$(MAKEFILE_LIST),$(_help_quote)$(f)$(_help_quote)))
help: ## Show this help message
	@echo Compose, from this directory: $(STENCIL_COMPOSE)
	@echo Available targets:
	@powershell -NoProfile -Command "Get-Content -LiteralPath @($(STENCIL_HELP_FILES)) | Select-String '^[a-zA-Z0-9_-]+:.*?## .*$$' | ForEach-Object { $$_ -match '^([a-zA-Z0-9_-]+):.*?## (.*)$$' | Out-Null; '  {0,-15} {1}' -f $$matches[1], $$matches[2] } | Select-Object -Unique"
else
help: ## Show this help message
	@echo "Compose, from this directory: $(STENCIL_COMPOSE)"
	@echo "Available targets:"
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}' | uniq
endif
