# Makefile for course activities
# Override to use another Compose implementation, e.g. DC="podman compose"
DC ?= docker compose

# The compose file(s) every invocation below pins, so that a
# docker-compose.override.yml or a .env COMPOSE_FILE sitting in the package
# directory is never auto-discovered and merged by compose's own resolution
# (stn-qli). A consumer who genuinely wants such a file merged in still can --
# by naming it explicitly, e.g.
# `make doc COMPOSE_FILES="docker-compose.yml docker-compose.override.yml"`.
COMPOSE_FILES ?= docker-compose.yml

# BARE PATHS, NOT PRE-FLAGGED -- the `-f` is added below, at the point of use,
# by $(addprefix -f ,$(COMPOSE_FILES)), rather than being part of the value a
# consumer types. With the flag baked into the value, the obvious spelling --
# `make COMPOSE_FILES=docker-compose.yml`, the one a consumer will actually
# type -- would render as the literal `docker compose docker-compose.yml run
# ...` and fail confusingly, because there would be nothing left to add a
# `-f` in front of. Bare paths also keep the public interface to exactly "a
# list of compose files": anything else a consumer stuffs in here (`-p`,
# `--env-file`, `--profile`) would work once and then have to keep working.
#
# `?=` ALONE DOES NOT GUARD AGAINST AN EMPTY VALUE -- it only tests whether
# COMPOSE_FILES is DEFINED, not whether it is non-empty. MEASURED on a
# patched Makefile: `make COMPOSE_FILES=`, `COMPOSE_FILES= make`, and
# `MAKEFLAGS='COMPOSE_FILES=' make` all leave `?=` satisfied and still
# produce `docker compose  run --rm format-md` -- unpinned, working, and
# SILENT -- and that invocation really does let a planted override merge
# back in. So an empty value is refused outright below, rather than left to
# `?=` to catch, which it cannot.
ifeq ($(strip $(COMPOSE_FILES)),)
$(error COMPOSE_FILES must name at least one compose file, e.g. COMPOSE_FILES=docker-compose.yml)
endif

# THIS GUARD IS HONEST-MISTAKE PROTECTION, NOT AN ATTACKER BOUNDARY. An
# exported COMPOSE_FILES beats `?=` and silently drops the pin for every
# package built in that shell, with no output at all -- the realistic actor
# is a CI job that exported it once, legitimately, for something unrelated,
# and never revisited it; this turns that into a loud failure naming the
# variable. It is NOT a security boundary: `MAKEFLAGS='COMPOSE_FILES=evil.yml'
# make` reports COMPOSE_FILES's origin as "command line", not "environment",
# and slips straight past this check -- but anyone who can set your MAKEFLAGS
# already has the run of your environment, so this is not a boundary this
# guard is trying to hold.
ifeq ($(origin COMPOSE_FILES),environment)
$(error COMPOSE_FILES from the environment is ignored; pass it on the make command line)
endif

# STENCIL_COMPOSE, NOT COMPOSE. `COMPOSE` is short, unnamespaced, and exactly
# the name a consumer composition might pick for its own purposes; make's
# last-assignment-wins rule means such a definition would silently override
# this one and unpin every call site below, with no guard able to catch a
# wrong-but-non-empty value the way the two guards above catch an empty one.
# `COMPOSE_FILES` keeps the guessable, unprefixed name instead, because it is
# the one knob a consumer is actually meant to set.
#
# RECURSIVE '=', NOT ':='. With ':=' COMPOSE_FILES would be expanded once,
# right here, and a composition that includes this partial and then sets
# COMPOSE_FILES afterward -- from its own text, the command line, or the
# environment -- would have that later value silently ignored, while every
# other way of setting a make variable keeps working. That is the kind of
# mistake that hides because it looks like it works.
STENCIL_COMPOSE = $(DC) $(addprefix -f ,$(COMPOSE_FILES))

# The runtime CLI that DC actually drives, derived rather than hardcoded. The
# four spellings pipeline.compose_command() falls through are "docker
# compose", "podman compose", "docker-compose" and "podman-compose", and
# ensure_image below needs the bare binary name to run `image inspect`
# against. $(subst -, ,$(DC)) turns "docker-compose" into two words so
# $(firstword ...) yields "docker" the same way it already does for "docker
# compose"; the same holds for the two podman spellings. Do NOT simplify this
# to plain $(firstword $(DC)) -- that reads correctly for the two-word
# spellings but returns the whole standalone binary name ("docker-compose")
# for the other two, and neither standalone binary has an `image inspect`
# subcommand, so the probe below would fail to run at all on those hosts.
CONTAINER ?= $(firstword $(subst -, ,$(DC)))

# Pull an image only when it is not already present. Four targets want this and
# the two shells share no spelling of it, so it lives here rather than as four
# copies of the same ifeq: cmd, which is what make runs recipes through on
# Windows, has no grep.
#
# THE PROBE IS `image inspect`, NOT the old `-q`-flagged `images` listing.
# MEASURED: once an image reference carries a digest, running that old probe
# against `<ref>` prints nothing even though the image is present locally
# under that exact digest -- the bare-tag form of the same probe (against
# `<tag>` alone) prints the id, which is how this went unnoticed: the guard
# looked like it worked because some other tag happened to satisfy it, while
# compose went and pulled the pinned reference anyway on every build.
# `image inspect <ref>` checks the reference actually named, digest included,
# and reports the image absent when the digest is wrong -- which is what this
# guard always claimed to do and, before this fix, could not. The same
# measurement holds for podman, and is the reason CONTAINER exists above
# rather than the literal "docker" this used to say: on a podman-only host
# the old `-q`-flagged listing doesn't merely miss the digest, it fails
# outright, so the guard was an unconditional pull there regardless of this
# bug.
#
# One more thing MEASURED, not assumed: `image inspect` ignores a stale or
# bogus TAG once a digest is present -- `hello-world:BOGUSTAG@sha256:...`
# inspects successfully on both docker and podman. That is the same rule the
# registry itself applies (a digest resolves on its own; the tag alongside it
# is a human label), and it is this epic's whole argument for keying pins by
# digest rather than by tag -- so the probe is consistent with how pulling
# actually resolves the reference. But it means this guard does not and
# cannot validate that the tag half of a ref still describes the digest; it
# only proves the digest is present.
#
# Both branches pull through $(STENCIL_COMPOSE) rather than $(DC), so a
# missed-image pull is pinned the same as every other invocation. The
# Windows branch puts it inside a DOUBLE-QUOTED PowerShell -Command string,
# which is safe for COMPOSE_FILES's own default (no quotes or spaces in
# "docker-compose.yml") but is not generally safe: a COMPOSE_FILES entry
# containing a space would need its own quoting inside that string, which
# this does not attempt, so such a path breaks the Windows branch.
ifeq ($(OS),Windows_NT)
ensure_image = @powershell -NoProfile -Command "$(CONTAINER) image inspect '$(1)' *> $$null; if ($$LASTEXITCODE -ne 0) { $(STENCIL_COMPOSE) pull $(2) }"
else
ensure_image = @$(CONTAINER) image inspect '$(1)' >/dev/null 2>&1 || $(STENCIL_COMPOSE) pull $(2)
endif

# Default target
ifeq ($(OS),Windows_NT)
help: ## Show this help message
	@echo Available targets:
	@powershell -NoProfile -Command "Get-Content $(MAKEFILE_LIST) | Select-String '^[a-zA-Z0-9_-]+:.*?## .*$$' | ForEach-Object { $$_ -match '^([a-zA-Z0-9_-]+):.*?## (.*)$$' | Out-Null; '  {0,-15} {1}' -f $$matches[1], $$matches[2] } | Select-Object -Unique"
else
help: ## Show this help message
	@echo "Available targets:"
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}' | uniq
endif
