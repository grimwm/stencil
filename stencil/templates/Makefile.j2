{% include 'Makefile-base.j2' %}
{% if '.stencil/documents.mk' not in capability_includes %}
.PHONY: help format-md clean clean-pkg pkg
format-md: ## Format markdown files
	$(call ensure_image,{{ node_image }},format-md)
	$(STENCIL_COMPOSE) run --rm format-md
{% endif %}
{% for inc in capability_includes %}
include {{ inc }}
{% endfor %}
{% include 'Makefile-pkg.j2' %}

clean: clean-pkg
