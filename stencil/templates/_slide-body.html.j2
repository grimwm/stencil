{# Deck body: a generated title slide followed by the slides produced by
   slide-sections.lua (one per heading at the configured slide level). #}
$if(title)$
<section class="slide slide--title">
$if(has-context)$
  {# One line, for the reason _doc-body.html.j2 gives. #}
$if(brand)$
  <div class="deck-brand$if(brand-is-image)$ deck-brand--image$endif$">$brand$</div>
$endif$
  <p class="deck-context">$if(program)$<span class="deck-program">$program$</span>$endif$$if(section)$<span class="deck-section">$section$</span>$endif$$if(term)$<span class="deck-term">$term$</span>$endif$</p>
$endif$
  <h1 class="deck-title">$title$$if(points-label)$ <span class="deck-points">$points-label$</span>$endif$</h1>
$if(subtitle)$
  <p class="deck-subtitle">$subtitle$</p>
$endif$
$if(author)$
  <p class="deck-meta">$for(author)$$author$$sep$ &middot; $endfor$$if(date)$ &middot; $date$$endif$</p>
$else$
$if(date)$
  <p class="deck-meta">$date$</p>
$endif$
$endif$
</section>
$endif$
$body$
