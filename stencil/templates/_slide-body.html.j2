{# Deck body: a generated title slide followed by the slides produced by
   slide-sections.lua (one per heading at the configured slide level). #}
$if(title)$
<section class="slide slide--title">
$if(has-context)$
  {# One line, for the reason _doc-body.html.j2 gives. #}
$if(brand)$
  <div class="deck-brand$if(brand-is-image)$ deck-brand--image$endif$">$brand$</div>
$endif$
  <p class="deck-context">$if(program)$<span class="deck-program">$program$</span>$endif$$if(section)$<span class="deck-section">$section$</span>$endif$$if(term)$<span class="deck-term">$term$</span>$endif$</p>
$endif$
  <h1 class="deck-title">$title$</h1>
$if(subtitle)$
  <p class="deck-subtitle">$subtitle$</p>
$endif$
$if(has-byline)$
  {# Two lines, matching the document header: authors above, facts below. A
     team's author list is the reason -- six names and three facts on one
     centred run wraps into an unreadable block on a title slide.

     Each line is one line of source on purpose: a newline between these
     collapses to a word space that lands on only one side of a separator.

     The separator flags are computed in frontmatter-filter.lua because each
     asks whether *any* of several keys precedes it, which a pandoc template
     cannot do. #}
$if(author)$
  <p class="deck-authors">$for(author)$<span class="deck-author">$author$</span>$sep$ <span class="deck-author-sep" aria-hidden="true">&middot;</span> $endfor$</p>
$endif$
$if(has-facts)$
  <p class="deck-meta">$if(date-label)$Issued <time datetime="$date-iso$">$date-label$</time>$endif$$if(due-label)$$if(sep-before-due)$ &middot; $endif$Due <time datetime="$due-iso$">$due-label$</time>$endif$$if(points-label)$$if(sep-before-points)$ &middot; $endif$Points $points-label$$endif$</p>
$endif$
$endif$
</section>
$endif$
$body$
