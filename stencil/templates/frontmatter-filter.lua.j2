--[[ Normalizes the front matter that the page and slide templates read.

Three jobs, every one of them something a pandoc template cannot do for itself:
a template can ask `$if(x)$`, but it cannot compare a string, OR two keys
together, or fill one key in from another.

* `show_date` is coerced to a boolean. Pandoc reads YAML 1.2, where `true` and
  `false` are the only booleans -- `show_date: no` arrives as the *string*
  "no", and `$if(show_date)$` fires on any non-empty string. So the obvious
  thing to write meant the exact opposite of itself, silently, in the
  direction that publishes something the author asked to withhold.

* `date` is filled from the build date when `show_date` is on and the author
  wrote no date of their own. Done here rather than in the template so the
  byline keeps asking one question, `$if(date)$`, rather than three.

* `has-context` and `has-byline` answer "is any of these set?" for the header
  rows, which exist only when they have something to hold.

Blank values are erased throughout, so `course:` with nothing after it behaves
as though the key were absent rather than rendering an empty span. Pandoc
already does this for some shapes and not others; doing it once here is
cheaper than knowing which is which.
]]

-- Everything a person might reasonably write to mean "no". Compared after
-- lowercasing and trimming, so `No` and ` off ` land here too.
local FALSE = {
  [""] = true,
  ["no"] = true,
  ["false"] = true,
  ["off"] = true,
  ["0"] = true,
  ["none"] = true,
  ["null"] = true,
}

-- The document's institutional context: what it belongs to, which instance of
-- that, and when. Named to survive outside a university -- `program` covers a
-- course and a training program equally -- while staying what an instructor
-- would say out loud.
-- Baked from .config.yaml at generation time: what a document falls back to
-- when its own front matter names no brand. A picture is named by the file
-- stencil copied into this package directory rather than the path it came
-- from, so the folder stands on its own when it is handed to someone.
--
-- Front matter still wins. This only fills the key in when it is absent, and
-- everything below then treats it exactly as though the document had written
-- it -- which is what keeps a config brand and a front-matter brand from
-- drifting into two behaviours.
-- Inline conditionals rather than {% raw %}{% if %}{% endraw %} blocks: the environment sets
-- trim_blocks, which eats the newline after a block tag and welded these two
-- declarations onto one line. `nil` and `local` then ran together into the
-- identifier `nillocal`, which Lua accepts -- so CONFIG_BRAND read an
-- undefined global and CONFIG_BRAND_ALT quietly became a global instead of a
-- local. Both still evaluated to nil, which is why nothing failed.
local CONFIG_BRAND = {{ (config_brand | tojson) if config_brand else "nil" }}
local CONFIG_BRAND_ALT = {{ (config_brand_alt | tojson) if config_brand_alt else "nil" }}

local CONTEXT = { "program", "section", "term" }

-- Every key whose blank form must be indistinguishable from its absent form.
-- `author` and `date` are here for the header rows below: an empty author is
-- falsy to `$if(author)$` but not to `~= nil`, so without this an `author:`
-- with nothing after it would open a byline row with nothing to put in it.
local BLANKABLE = {
  "program", "section", "term", "author", "date", "lang", "dir",
  "brand", "brand-alt", "points",
}

-- What `brand` is taken to be a picture of rather than a name.
local IMAGE_EXT = {
  png = true, jpg = true, jpeg = true, gif = true,
  svg = true, webp = true, avif = true,
}

--- The image `brand` points at, or nil when it is a name rather than a file.
---
--- `file://x` is rewritten to plain `x` on purpose. embed-images.lua treats
--- anything matching `^%a[%w+.-]*://` as remote and leaves it alone, so a
--- file:// URI would be the one spelling that never gets inlined -- the page
--- would carry a path instead of the picture, and html-to-pdf.js fails the
--- build on an asset it cannot fetch. Stripping the scheme hands it to that
--- filter as an ordinary relative path, which is what it knows how to bundle.
---
--- A genuinely remote URL is returned unchanged and stays a reference. That is
--- embed-images.lua's documented position on remote images, and this is not
--- the place to overturn it.
local function image_target(text)
  local relative = text:match("^file://(.+)$")
  if relative then
    return relative
  end
  if text:match("^data:") or text:match("^%a[%w+.-]*://") then
    return text
  end
  local ext = text:match("%.([%w]+)$")
  if ext and IMAGE_EXT[ext:lower()] then
    return text
  end
  return nil
end

local function trim(text)
  -- match, not a chained gsub: gsub returns the replacement count as a second
  -- value, which would ride along into whatever this feeds.
  return text:match("^%s*(.-)%s*$")
end

--- The metadata value as a trimmed string, or nil when it holds nothing.
local function text_of(value)
  if value == nil then
    return nil
  end
  -- MetaBool reaches the Lua API as a plain boolean, which stringify would
  -- render "true"/"false" -- fine for the truthiness test below, wrong for
  -- anything that goes on the page. Callers that care check the type first.
  if type(value) == "boolean" then
    return tostring(value)
  end
  local text = trim(pandoc.utils.stringify(value))
  if text == "" then
    return nil
  end
  return text
end

--- Whether a metadata value means yes. Absent means no.
local function truthy(value)
  if value == nil then
    return false
  end
  if type(value) == "boolean" then
    return value
  end
  local text = text_of(value)
  return text ~= nil and not FALSE[text:lower()]
end

function Meta(meta)
  -- A blank key is an absent key. Do this before anything reads them.
  for _, key in ipairs(BLANKABLE) do
    if meta[key] ~= nil and text_of(meta[key]) == nil then
      meta[key] = nil
    end
  end

  local show = truthy(meta.show_date)
  -- Written back as a real boolean so a template asking $if(show_date)$ gets
  -- the answer this filter computed rather than the author's spelling of it.
  meta.show_date = show or nil

  if show and text_of(meta.date) == nil then
    -- The Makefile passes the build host's date; os.date is the fallback for
    -- a hand-run pandoc, and inside the container that is UTC.
    meta.date = text_of(meta["build-date"]) or os.date("%Y-%m-%d")
  end

  if meta.brand == nil and CONFIG_BRAND ~= nil then
    meta.brand = pandoc.Inlines({ pandoc.Str(CONFIG_BRAND) })
    if meta["brand-alt"] == nil and CONFIG_BRAND_ALT ~= nil then
      meta["brand-alt"] = pandoc.Inlines({ pandoc.Str(CONFIG_BRAND_ALT) })
    end
  end

  -- `brand` is either a name or a picture, and the difference decides both
  -- what the template emits and whether alt text is required.
  local brand = text_of(meta.brand)
  if brand then
    local target = image_target(brand)
    if target then
      local alt = text_of(meta["brand-alt"])
      if not alt then
        -- Refused rather than defaulted. A logo is frequently the only thing
        -- naming the institution on the page, so a silent alt="" would drop
        -- that for anyone using a screen reader, and `make check-access`
        -- runs pa11y at WCAG2AA. Failing here says so while the author is
        -- still looking at the document.
        error(
          "brand is an image (" .. brand .. ") but brand-alt is not set. "
          .. "Add brand-alt: with the text a reader should hear in place of "
          .. "the logo, or use a plain string for brand to render it as text."
        )
      end
      meta.brand = pandoc.Inlines({
        pandoc.Image(pandoc.Inlines({ pandoc.Str(alt) }), target),
      })
      meta["brand-is-image"] = true
    end
  end

  -- Points is a number the reader cares about, so the badge says "1 pt" rather
  -- than "1 pts". Computed here because a pandoc template cannot compare a
  -- value -- the same reason `date` is filled in here rather than there.
  --
  -- A value that is not a number renders verbatim, so `points: "extra credit"`
  -- is a usable escape hatch rather than a build failure. There is nothing to
  -- validate about it: unlike a date, any string is a legible answer to "what
  -- is this worth".
  local points = text_of(meta.points)
  if points then
    local count = tonumber(points)
    local label
    if count == nil then
      label = points
    elseif count == 1 then
      label = points .. " pt"
    else
      label = points .. " pts"
    end
    meta["points-label"] = pandoc.Inlines({ pandoc.Str(label) })
  end

  local has_context = false
  for _, key in ipairs(CONTEXT) do
    has_context = has_context or meta[key] ~= nil
  end
  meta["has-context"] = (has_context or meta.brand ~= nil) or nil
  meta["has-byline"] = (meta.author ~= nil or meta.date ~= nil) or nil

  return meta
end
