{% if has_pages %}
  # Prints an already-generated HTML file to PDF. This is a stage after the
  # doc/slide services rather than a second pandoc pipeline: the @page and
  # @media print rules the HTML already carries are the page geometry, so the
  # PDF and the browser's own Ctrl+P produce the same document.
  #
  # Invoked as: docker compose run --rm pdf <input.html> <output.pdf>
  # The trailing "--" is $0 for `sh -c`, so those two land in "$@".
  pdf:
    image: docker.io/library/node:lts-alpine
    volumes:
      - .:/workspace:z
    working_dir: /workspace
    environment:
      - NPM_CONFIG_UPDATE_NOTIFIER=false
      # Chromium comes from apk, so there is nothing for Puppeteer to download.
      - PUPPETEER_SKIP_DOWNLOAD=true
      - PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
    entrypoint:
      - sh
      - -c
      - |
        set -e
        # font-noto backs the CDN webfonts. Without a real font installed,
        # Chromium falls back to metrics that move every page break.
        apk add --no-cache chromium font-noto ttf-dejavu > /dev/null 2>&1
        npm install --prefix /tmp/pdf puppeteer > /dev/null 2>&1
        export NODE_PATH=/tmp/pdf/node_modules
        exec node html-to-pdf.js "$$@"
      - --
    restart: "no"

{% endif %}
