{% if package_type == "zip" or has_package_sources %}
# What `pkg` puts into the submission. One rule for every package type:
#
#   md/*.md    a glob -- expands in sorted order
#   md         a directory -- every file under it, at any depth, dotfiles aside
#   intro.md   anything else -- passed through as written, in the listed position
#
# Nothing is filtered by extension and nothing is inferred from a name: to take
# only the markdown out of a directory, say so with a glob. Expansion happens at
# build time, so a file created after this Makefile was generated resolves too.
PKG_SOURCE_SPECS = {{ package_sources | join(' ') }}
{% if package_type == "zip" %}
# Both archivers walk a directory themselves, dotfiles and hidden files
# included, so a directory entry is handed over whole rather than expanded into
# its children here. Which archiver runs is not a detail on Windows -- see the
# pkg target below.
pkg_expand = $(if $(findstring *,$(1)),$(sort $(wildcard $(1))),$(1))
{% else %}
# pandoc reads files, not directories, so a directory entry is expanded into
# the files under it -- recursively, to match the zip side, where zip -r walks
# the whole tree. Each platform walks with its own tool, because make has no
# recursive glob and a student on Windows runs recipes through cmd, which has
# no find -- and whose own find.exe is a text search that would fail obscurely
# rather than cleanly. Both yield relative, forward-slashed paths, files only,
# sorted by byte so a document's reading order does not shift with the caller's
# locale. Dotfiles are skipped where zip -r keeps them: zip does not care what
# is in a file and pandoc does, so the stray .DS_Store that zip would harmlessly
# archive is a failed build here. $(wildcard x/.) is make's directory test.
ifeq ($(OS),Windows_NT)
pkg_walk = $(shell powershell -NoProfile -Command "Get-ChildItem -LiteralPath '$(1)' -File -Recurse | ForEach-Object { $$_.FullName.Substring((Get-Location).Path.Length + 1).Replace('\','/') } | Where-Object { $$_ -notmatch '(^|/)\.' } | Sort-Object")
else
pkg_walk = $(shell find $(1) -type f -not -path '*/.*' | LC_ALL=C sort)
endif
pkg_expand = $(if $(wildcard $(1)/.),$(call pkg_walk,$(1)),$(if $(findstring *,$(1)),$(sort $(wildcard $(1))),$(1)))
{% endif %}
PKG_SOURCES = $(foreach s,$(PKG_SOURCE_SPECS),$(call pkg_expand,$(s)))

{% endif %}
{% if package_type == "zip" %}
# `?=` rather than `=`: a consumer may override Makefile.j2 and define PKG in
# its own composition before including this partial, and that definition wins.
# Without a default here at all, a package generated from the bundled templates
# alone had an empty $(PKG) -- `clean-pkg` cleaned nothing and the archiver was
# handed no name to write to.
PKG ?= {{ package_name }}

ifeq ($(OS),Windows_NT)
# bsdtar, shipped as tar.exe since Windows 10 1803 -- not Compress-Archive,
# which cannot archive a hidden file at all. `git init` on Windows sets the
# Hidden attribute on .git (git's core.hideDotFiles defaults to dotGitOnly, so
# .git gets the bit and other dot-names do not), and Compress-Archive expands a
# directory with Get-ChildItem WITHOUT -Force, so it drops the whole subtree --
# silently, absent even from -Verbose. A student who ran `git init` inside the
# packaged directory submitted an archive with no repository in it, while the
# same layout on Unix archived one, because `zip -r` has no notion of hidden.
#
# --format zip, and NOT -a, which infers format and compression from the
# suffix. Both of -a's mistakes are silent ones:
#
#   * In Git Bash and MSYS2 $(OS) is still Windows_NT but `tar` is GNU tar,
#     whose -a does not know .zip: it exits 0 and writes a POSIX tar archive
#     under the .zip name. --format zip is an error there, so make stops.
#   * package_name need not end in .zip, and -a gzips the zip when it does not.
#
# An explicit format is a zip whatever the archive is called, which is what the
# `zip -r` below already did, and a loud failure wherever it cannot be.
pkg: ## Create submission zip file
	@echo Creating submission zip file...
	tar --format zip -cf "$(PKG)" $(PKG_SOURCES)
	@echo Created $(PKG)
	@echo Upload $(PKG) to the course website.
else
pkg: ## Create submission zip file
	@echo "Creating submission zip file..."
	zip -r $(PKG) $(PKG_SOURCES)
	@echo "Created $(PKG)"
	@echo "Upload $(PKG) to the course website."
endif

{% elif has_package_sources %}
# A composition may include this partial without Makefile-base.j2 first --
# AGENTS.md documents composing these partials a la carte, and
# tests/test_template_contract.py includes this one on its own. Without this
# guard the failure is `make: run: No such file or directory`, which names
# neither stencil nor the missing include; this names both. It sits in this
# arm rather than at the top of the file because this is the only arm that
# invokes compose: the zip arm archives with tar or zip, and a package_type
# of "none" renders nothing here but clean-pkg.
ifeq ($(strip $(STENCIL_COMPOSE)),)
$(error Makefile-pkg needs STENCIL_COMPOSE: include Makefile-base.j2 before this include, or define it yourself)
endif

PKG_HTML = {{ package_stem }}$(OUTPUT_SUFFIX).html
PKG = {{ package_stem }}$(OUTPUT_SUFFIX).pdf

# One pandoc run over every source, so the result is a single flowing document
# rather than one page per file. $(OUTPUT_SUFFIX) is on both the HTML and the
# PDF so `make pkg with=hidden` prints the answer-key HTML into the answer-key
# PDF rather than pairing one with the other.
pkg: format-md ## Build {{ package_name }} from {{ package_sources | join(' ') }}
	$(if $(strip $(PKG_SOURCES)),,$(error package_sources matched nothing: $(PKG_SOURCE_SPECS)))
	$(call ensure_image,{{ pandoc_image }},doc)
	$(STENCIL_COMPOSE) run --rm doc --metadata course="{{ name }}" $(METADATA_FLAGS) $(PKG_SOURCES) -o $(PKG_HTML)
	$(STENCIL_COMPOSE) build pdf
	$(STENCIL_COMPOSE) run --rm pdf $(PKG_HTML) $(PKG)
	@echo "Created $(PKG)"
	@echo "Upload $(PKG) to the course website."

{% endif %}
{# The products are gathered here and emitted by the one expression on the last
   line, and that shape is load-bearing. This partial is included by consumer
   compositions that write their own next line -- cs234's follows it with
   `pkg: fix lint lint-sql`. trim_blocks strips the newline after a block tag,
   so a last line that ended in `{% endfor %}` ended the whole include
   mid-line, and the consumer's rule rendered as the tail of this rm recipe:
   `make pkg` linted nothing, in every assignment. A `{{ }}` keeps its newline.
   tests/test_template_contract.py checks every partial ends with one. #}
{% set products = [] %}
{% if package_type == "zip" %}{% do products.append('$(PKG)') %}{% endif %}
{% if has_package_sources %}
{% for suffix in ['.html', '-*.html', '.pdf', '-*.pdf'] %}{% do products.append('$(OUT_HOST)/' ~ package_stem ~ suffix) %}{% endfor %}
{% endif %}
{% for md in docs + slides %}
{% for suffix in ['.html', '-*.html', '.pdf', '-*.pdf'] %}{% do products.append('$(OUT_HOST)/' ~ (md | replace('.md', suffix))) %}{% endfor %}
{% endfor %}
clean-pkg: ## Remove generated files
	rm -f {{ products | join(' ') }}
