{# Shared image for the pdf and check-access services. Both drive Chromium from
   Node, and both used to install it at run time -- roughly twelve seconds on
   every single invocation, paid once per file. Building it instead lets the
   container engine cache the layers, so the cost lands on the first run and
   never again. #}
FROM {{ node_image }}

# Puppeteer's bundled Chromium download has no musl build, and pa11y drives the
# same browser anyway, so both use the distro package.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Resolve `require("puppeteer")` and the pa11y binary from the tree installed
# below rather than from a node_modules directory inside the mounted workspace.
#
# A LOCAL INSTALL, WHICH IS WHY THESE TWO PATHS LOOK LIKE THIS. `npm ci` has no
# `--global`, so /opt/tools is no longer a global prefix and the layout it used
# -- lib/node_modules for modules, bin for binaries -- is gone with it. Modules
# are now at node_modules and binaries at the node_modules/.bin symlinks npm
# writes itself, so neither line needs a hand-made symlink and both come from
# stencil/pipeline.py rather than being spelled out here.
ENV NODE_PATH={{ browser_node_modules }}
ENV PATH={{ browser_node_modules }}/.bin:$PATH

# CHROMIUM IS DELIBERATELY NOT PINNED, and the reasoning is worth keeping here
# rather than in a commit message, because the obvious "fix" makes things worse.
#
# Alpine's repository holds exactly ONE version of a package per branch and
# drops it the moment it is superseded. A pin is therefore not a pin; it is a
# countdown. Measured on this image's own base:
#
#     $ apk add --no-cache chromium=151.0.7716.0-r0
#     ERROR: unable to select packages:
#       chromium-152.0.7977.82-r0:
#         breaks: world[chromium=151.0.7716.0-r0]
#
# That is the version this image installed one release ago, already unusable.
# The fuzzy spelling `chromium=~152` does hold the major and does resolve today
# -- and fails exactly that way the week Alpine moves to 153.
#
# Either one converts silent drift into a hard build failure with no escape
# hatch on the consumer's side: the Makefile and the compose file build this
# image with no build argument, and stencil rewrites both on the next
# `make gen`, so a course repository would be stuck until a stencil release
# landed. A handout nobody can build is worse than one whose page breaks moved
# -- and where the page breaks land is measured directly, on every pull
# request, by the container tier in tests/test_pdf.py and the PDF/UA suite.
#
# What stencil CAN pin is the Alpine branch this installs from, which is the
# base image above.
#
# The asymmetry -- Node pinned exactly, Chromium floating -- is the right way
# round for a second reason. Chromium runs here with --no-sandbox, and it is
# the process that actually parses and renders the content, so leaving it on
# the distro package means every fresh build picks up Alpine's patches for it.
# Node is pinned and therefore does not, but Node here only drives local
# tooling over locally generated, self-contained HTML.
#
# Measured, because the reason usually given for --no-sandbox is the wrong one:
# this image sets no USER and neither service sets a compose `user`, so
# `id` inside it reports uid=0(root). Chromium refuses to enable its own
# sandbox as root. It is not that an unprivileged container cannot sandbox --
# it is that nothing here is unprivileged.
#
# font-noto covers characters outside the latin/latin-ext faces the page
# inlines. With no real font installed, Chromium lays out at fallback metrics
# and every page break moves.
RUN apk add --no-cache chromium font-noto ttf-dejavu

# pdf-lib is used after printing, to add the role map and XMP metadata that
# PDF/UA-1 requires and Chromium does not write. See html-to-pdf.js.
RUN mkdir -p {{ browser_tools_dir }} \
 && printf '%s\n' '{{ browser_manifest }}' > {{ browser_tools_dir }}/package.json
COPY {{ browser_lockfile_name }} {{ browser_tools_dir }}/package-lock.json

RUN if ! echo "{{ browser_lockfile_digest }}  {{ browser_tools_dir }}/package-lock.json" \
      | sha256sum -c >/dev/null; then \
      echo "Dockerfile.browser: {{ browser_lockfile_name }} is not the file stencil generated." >&2; \
      echo "That file is stencil's. It is the lockfile this image installs from," >&2; \
      echo "and editing it has no supported effect: a changed 'resolved' URL would" >&2; \
      echo "decide which bytes become the puppeteer, pa11y and pdf-lib that run" >&2; \
      echo "here, as root, over the mounted package -- so the build refuses it" >&2; \
      echo "rather than installing from it." >&2; \
      echo "Run 'stencil gen' for this package to restore it." >&2; \
      echo "If you deliberately override browser-package-lock.json.j2 from your" >&2; \
      echo "own templates_dir, 'stencil gen' will not help: the digest above is" >&2; \
      echo "stencil's vendored lockfile, not your rendered one. Override this" >&2; \
      echo "Dockerfile's guard with it, or drop the override. See STENCIL.md." >&2; \
      echo "On Windows: generated files are written CRLF, which" >&2; \
      echo "changes this digest even though nobody edited the file." >&2; \
      exit 1; \
    fi
#
# --ignore-scripts, and it costs nothing here. A lifecycle script runs as root
# during the build, with network, before any test in this repository gets to
# look -- and a transitive package that GAINS a postinstall arrives as one
# added boolean in a 48-entry JSON diff. The only install script in this tree
# is puppeteer's, whose whole job is downloading Chromium, and
# PUPPETEER_SKIP_DOWNLOAD above already says not to. Measured on npm 11.19.0:
# `npm ci --ignore-scripts` adds all 47 packages and leaves node_modules/.bin
# holding pa11y and puppeteer either way, because bin symlinks are the
# linker's work rather than a script's. tests/test_pins.py freezes the set of
# packages that declare one, so a new arrival is a red test rather than a
# quiet execution.
#
# `cd` rather than `--prefix`, so this does not depend on which directory the
# build happens to be in. It is `/` today, and a WORKDIR added above this line
# would silently change what npm reads.
RUN cd {{ browser_tools_dir }} && npm ci --ignore-scripts --no-audit --no-fund

# One pa11y config per theme, each driving the control before measuring.
# chromeLaunchConfig is in both: this image runs as root -- it sets no USER and
# no service sets a compose `user` -- and Chromium refuses to enable its own
# sandbox as root.
#
# pa11y has no --run-before; it has `actions`, which is better here anyway --
# clicking the real segment exercises the same path a reader does rather than
# asserting about a page that was set up some other way.
#
# Both are forced. Leaving the light pass to resolve `system` would measure
# whatever preference the runner reports -- on a machine reporting dark, both
# passes would measure dark and the light palette would go unchecked while
# the check still went green.
#
# Checking one theme would leave the other's contrast unmeasured, and those
# are the ratios nobody has looked at: 0.11.0 shipped a label at 3.88:1 that
# looked entirely unremarkable.
RUN for theme in light dark; do \
      printf '%s\n' \
        '{' \
        '  "chromeLaunchConfig": {' \
        '    "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]' \
        '  },' \
        '  "actions": [' \
        "    \"click element .theme-toggle__option[data-theme=\\\"$theme\\\"]\"" \
        '  ]' \
        '}' > "/opt/pa11y-$theme.json"; \
    done

COPY html-to-pdf.js {{ browser_tools_dir }}/html-to-pdf.js

WORKDIR /workspace
