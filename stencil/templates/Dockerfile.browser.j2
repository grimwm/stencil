{# Shared image for the pdf and check-access services. Both drive Chromium from
   Node, and both used to install it at run time -- roughly twelve seconds on
   every single invocation, paid once per file. Building it instead lets the
   container engine cache the layers, so the cost lands on the first run and
   never again. #}
FROM docker.io/library/node:lts-alpine

# Puppeteer's bundled Chromium download has no musl build, and pa11y drives the
# same browser anyway, so both use the distro package.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Resolve `require("puppeteer")` and the pa11y binary from the shared prefix
# below rather than from a node_modules tree inside the mounted workspace.
ENV NODE_PATH=/opt/tools/lib/node_modules
ENV PATH=/opt/tools/bin:$PATH

# font-noto covers characters outside the latin/latin-ext faces the page
# inlines. With no real font installed, Chromium lays out at fallback metrics
# and every page break moves.
RUN apk add --no-cache chromium font-noto ttf-dejavu

RUN npm install --global --prefix /opt/tools puppeteer pa11y

# One pa11y config per theme, each driving the control before measuring.
# chromeLaunchConfig is in both: Chromium cannot use its own sandbox inside
# an unprivileged container.
#
# pa11y has no --run-before; it has `actions`, which is better here anyway --
# clicking the real segment exercises the same path a reader does rather than
# asserting about a page that was set up some other way.
#
# Both are forced. Leaving the light pass to resolve `system` would measure
# whatever preference the runner reports -- on a machine reporting dark, both
# passes would measure dark and the light palette would go unchecked while
# the check still went green.
#
# Checking one theme would leave the other's contrast unmeasured, and those
# are the ratios nobody has looked at: 0.11.0 shipped a label at 3.88:1 that
# looked entirely unremarkable.
RUN for theme in light dark; do \
      printf '%s\n' \
        '{' \
        '  "chromeLaunchConfig": {' \
        '    "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]' \
        '  },' \
        '  "actions": [' \
        "    \"click element .theme-toggle__option[data-theme=\\\"$theme\\\"]\"" \
        '  ]' \
        '}' > "/opt/pa11y-$theme.json"; \
    done

WORKDIR /workspace
