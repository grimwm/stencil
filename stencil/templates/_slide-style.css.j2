{# Slide-deck styling layered on top of _page-style.css.j2.

   Screen: a vertical stack of slide cards you can read like a document.
   Present mode (the "Present" button, or pressing "p"): one slide at a time,
   sized to the viewport. Because the whole stylesheet is rem-based, present
   mode simply scales the root font size and every slide scales with it.
   Print: one slide per landscape page. #}
    /* --- Deck layout --- */
    .container.deck {
      max-width: 72rem;
    }

    .slide {
      counter-increment: slide;
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 30rem;
      margin: 0 0 2rem;
      padding: 2.25rem 2.75rem 3rem;
      background: var(--deck-surface);
      border: 1px solid var(--deck-border);
      border-radius: 10px;
      box-shadow: 0 2px 14px var(--deck-shadow);
      break-after: page;
    }

    /* Slide number badge */
    .slide::after {
      content: counter(slide);
      position: absolute;
      right: 1.5rem;
      bottom: 1rem;
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
      color: var(--deck-counter);
    }

    /* The slide's own heading is its title bar, whatever level it came in at.
       The title slide is excluded: its .deck-title is an h1, and it is
       :first-child exactly when no context line precedes it. This selector
       scores (0,2,1) against .deck-title's (0,2,0), so it captured the deck
       title and sized it as a section heading -- and only when `program:` was
       unset, which is what made it look like a print bug (stn-tum). */
    .slide:not(.slide--title) > h1:first-child,
    .slide:not(.slide--title) > h2:first-child,
    .slide:not(.slide--title) > h3:first-child {
      margin-top: 0;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--accent);
      color: var(--accent);
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .slide:not(.slide--title) > h3:first-child { font-size: 1.5rem; }

    .slide > :last-child { margin-bottom: 0; }

    .slide ul, .slide ol { margin-bottom: 0.75rem; }
    .slide li { margin-bottom: 0.35rem; }
    .slide li > ul, .slide li > ol { margin-top: 0.35rem; }

    /* --- Title slide --- */
    .slide--title {
      justify-content: center;
      align-items: flex-start;
      background: linear-gradient(135deg, var(--deck-accent-from) 0%, var(--deck-accent-to) 100%);
      border-color: var(--deck-accent-edge);
      color: var(--on-accent);
    }

    /* Brand above the context line on a title slide, the same order a
       document's header uses. White-on-gradient, so a logo with its own
       background is the author's to supply appropriately. */
    .slide--title .deck-brand {
      font-family: var(--font-sans);
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--on-accent);
      margin-bottom: 0.6rem;
    }

    .slide--title .deck-brand--image {
      font-size: 0;
      line-height: 0;
    }

    .slide--title .deck-brand img {
      max-height: 3.5rem;
      max-width: 18rem;
      height: auto;
      width: auto;
    }

    /* Program, section and term on one line above the title. A deck has the
       width for all three, so unlike the document header this does not wrap
       the term onto its own line. */
    .slide--title .deck-context {
      font-family: var(--font-sans);
      font-size: 0.95rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--on-accent-muted);
      margin-bottom: 1rem;
    }

    /* Generated between siblings, so no combination of the three leaves a
       separator with nothing on one side of it. */
    .slide--title .deck-context span + span::before {
      content: "\00b7";
      margin: 0 0.45em;
      color: var(--on-accent-faint);
    }

    /* As in the document header: the section joins its program with a full
       stop and no gap, so "CS 425.001" reads as one identifier. */
    .slide--title .deck-context .deck-section::before {
      content: ".";
      margin: 0;
      color: inherit;
    }

    .slide--title .deck-title {
      font-family: var(--font-sans);
      font-size: 2.9rem;
      font-weight: 700;
      line-height: 1.12;
      margin: 0 0 0.75rem;
      border: none;
      padding: 0;
      color: var(--on-accent);
    }

    .slide--title .deck-subtitle {
      font-size: 1.5rem;
      font-style: italic;
      line-height: 1.35;
      color: var(--on-accent-bright);
      margin-bottom: 1.25rem;
      max-width: 46rem;
    }


    /* Authors above the facts, matching the document header. flex-wrap so a
       team's list wraps between names and stays centred rather than running
       off the slide. */
    .slide--title .deck-authors {
      text-align: center;
      font-family: var(--font-sans);
      font-size: 1.05rem;
      color: var(--on-accent-bright);
      margin: 0 0 0.35rem;
    }

    .slide--title .deck-author {
      white-space: nowrap;
    }

    .slide--title .deck-author-sep {
      color: var(--on-accent-faint);
    }

    .slide--title .deck-meta {
      font-family: var(--font-sans);
      font-size: 1rem;
      color: var(--on-accent-muted);
      margin: 0;
    }

    /* The title slide is the cover, not a numbered slide, so it shows no badge.
       It still increments the counter, which keeps the badge and the toolbar's
       "n / total" position in agreement rather than one apart. */
    .slide--title::after { content: none; }

    /* --- Content helpers usable from markdown fenced divs --- */

    /* ::: columns  ->  side-by-side halves; ::: {.columns .wide-left} to bias */
    .columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
      align-items: start;
    }
    .columns.wide-left  { grid-template-columns: 1.6fr 1fr; }
    .columns.wide-right { grid-template-columns: 1fr 1.6fr; }
    .columns > * > :first-child { margin-top: 0; }
    .columns > * > :last-child { margin-bottom: 0; }

    /* ::: lead-in  ->  a pull statement, the one thing to remember */
    .lead-in {
      font-size: 1.3rem;
      line-height: 1.45;
      color: var(--deck-body-text);
      border-left: 4px solid var(--accent);
      padding-left: 1rem;
      margin: 0.5rem 0 1rem;
    }

    /* ::: takeaway  ->  boxed conclusion, sits at the bottom of a slide */
    .takeaway {
      margin-top: auto;
      background: var(--deck-quote-bg);
      border: 1px solid var(--deck-quote-border);
      border-radius: 8px;
      padding: 0.85rem 1.15rem;
      font-family: var(--font-sans);
      font-size: 1rem;
    }
    .takeaway > :last-child { margin-bottom: 0; }
    .takeaway strong { color: var(--accent); }

    .center { text-align: center; }

    /* --- Media sizing: never let one figure push a slide off the page --- */
    .slide figure { margin: 0.75rem auto; }
    .slide figure img,
    .slide p > img {
      max-height: min(42vh, 24rem);
      width: auto;
      max-width: 100%;
    }
    .slide .mermaid { margin: 0.75rem 0; }
    .slide .mermaid svg { max-height: min(42vh, 24rem); height: auto; }
    .slide table { font-size: 0.95rem; }
    .slide pre { font-size: 0.9rem; }
    .slide blockquote { margin-left: 0; }

    /* --- Toolbar (screen only) --- */
    .deck-toolbar {
      position: fixed;
      left: 1rem;
      bottom: 1rem;
      z-index: 1050;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      background: var(--deck-toolbar-bg);
      border: 1px solid var(--deck-toolbar-border);
      border-radius: 999px;
      padding: 0.35rem 0.5rem 0.35rem 0.9rem;
      box-shadow: 0 2px 10px var(--deck-shadow-md);
      /* Draggable, for when it sits on top of a figure. `grab` belongs to the
         bar itself; the button below keeps its own pointer cursor. */
      cursor: grab;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      transition: opacity 0.32s ease, transform 0.32s ease;
    }

    .deck-toolbar.is-dragging {
      cursor: grabbing;
      /* No easing mid-drag: the bar has to track the pointer exactly. */
      transition: none;
      box-shadow: 0 6px 20px var(--deck-shadow-lg);
    }

    /* Idle. Faded rather than display:none so the return can animate, and
       click-through so an invisible bar never swallows a click meant for the
       slide underneath it. */
    .deck-toolbar.is-idle {
      opacity: 0;
      transform: translateY(0.6rem) scale(0.97);
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .deck-toolbar { transition: opacity 0.01ms linear; }
      .deck-toolbar.is-idle { transform: none; }
    }

    .deck-toolbar button {
      font: inherit;
      color: var(--on-accent);
      background: var(--accent);
      border: none;
      border-radius: 999px;
      padding: 0.3rem 0.9rem;
      cursor: pointer;
    }

    .deck-toolbar button:hover { background: var(--deck-toolbar-hover); }
    .deck-toolbar button:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }
    .deck-position { color: var(--deck-toolbar-fg); font-variant-numeric: tabular-nums; }

    /* --- Present mode: one slide, full viewport --- */
    html.presenting { font-size: clamp(16px, 0.85vw + 11px, 25px); }
    html.presenting body { overflow: hidden; background: var(--deck-presenting-bg); }
    html.presenting .container.deck { max-width: none; padding: 0; }
    html.presenting .slide { display: none; }

    /* Hiding the others with display:none drops them out of the slide counter,
       which would leave the badge reading "1" on every slide. The deck script
       stamps the position as data-slide-number; read that instead while
       presenting. The title slide stays unnumbered, as it is when scrolling. */
    html.presenting .slide:not(.slide--title)::after {
      content: attr(data-slide-number);
    }

    html.presenting .slide.is-current {
      display: flex;
      position: fixed;
      inset: 0;
      margin: 0;
      min-height: 0;
      padding: 2.5rem 3.5rem 3rem;
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow: auto;
    }

    html.presenting .slide.is-current figure img,
    html.presenting .slide.is-current .mermaid svg {
      max-height: 52vh;
    }

    /* --- Print: one slide per landscape page --- */
    @media print {
      @page { size: letter landscape; margin: 0.45in; }

      .deck-toolbar { display: none !important; }

      .container.deck { max-width: 100%; }

      /* Fill most of the page so a short slide still puts its takeaway and its
         slide number at the bottom, but stay clear of the page box so a slide
         never spills a blank second page. */
      .slide {
        min-height: 6.8in;
        margin: 0;
        padding: 0 0 0.3in;
        border: none;
        border-radius: 0;
        box-shadow: none;
        break-after: page;
        break-inside: avoid;
      }

      .slide:last-child { break-after: auto; }

      .slide::after {
        right: 0;
        bottom: 0.05in;
      }

      /* The title slide is excluded because its .deck-title is an h1 that is
         :first-child exactly when the front matter sets no program -- so
         the screen rule above carries the same exclusion and the same
         reason. Restating a size for .deck-title here would be a second
         scale to keep in step with the first; the exclusion is the fix, and
         tests/test_frontmatter.py measures the result off a real PDF. */
      .slide:not(.slide--title) > h1:first-child,
      .slide:not(.slide--title) > h2:first-child,
      .slide:not(.slide--title) > h3:first-child { font-size: 20pt; }


      .slide--title {
        background: var(--print-deck-bg) !important;
        color: var(--print-deck-fg) !important;
        padding: 1.5rem !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .takeaway {
        background: var(--print-deck-quote-bg) !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .slide figure img,
      .slide .mermaid svg { max-height: 3.6in; }
    }
